# Template only. Compose loads the ignored real sibling into hawki_backend only.
# Provision it before Compose startup; verify schema 0009, role, issuer and grants.
# These blank secrets deliberately fail readiness. Provision externally.
HAWKI_BACKEND_REQUIRE_READY_SCHEMA=true
HAWKI_BACKEND_DB_DSN=
HAWKI_BACKEND_DB_POOL_SIZE=5
HAWKI_BACKEND_DB_POOL_TIMEOUT_SECONDS=3
HAWKI_BACKEND_DB_POOL_RECYCLE_SECONDS=300
HAWKI_BACKEND_DB_CONNECT_TIMEOUT_SECONDS=3
HAWKI_BACKEND_DB_STATEMENT_TIMEOUT_MS=2000
HAWKI_BACKEND_AUTH_ISSUER=
HAWKI_BACKEND_AUTH_AUDIENCE=hawki-backend
HAWKI_BACKEND_AUTH_JWKS_URL=
# Public service-issuer key identifier used by the live JWKS readiness probe.
HAWKI_BACKEND_READINESS_JWKS_KEY_ID=
HAWKI_BACKEND_AUTH_CLIENTS={"hawki-service":"service","rag-management":"service"}
HAWKI_BACKEND_AUTH_ALGORITHMS=RS256
# Export the actual effective chat/vision models; do not copy placeholder models.
HAWKI_BACKEND_QUERY_MODELS=
# Local HAWKI Cohere-compatible service; readiness performs one tiny inference.
HAWKI_BACKEND_QUERY_RERANKER=external
RERANKER_API_URL=http://hawki_rag_rerank/v1/rerank
RERANKER_API_DIALECT=hawki-cohere-v1
RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v1
HAWKI_RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v1
RERANKER_API_KEY=
# Must match the server model and its optional Bearer credential.
HAWKI_BACKEND_QUERY_DATASET_SOURCE=database
# HAWKI_BACKEND_QUERY_DATASETS must be ABSENT, including empty values.
HAWKI_WORKFLOW_CONTROL_URL=http://hawki_backend
HAWKI_WORKFLOW_CONTROL_ENABLED=true
HAWKI_BACKEND_URL_INGESTION_ENABLED=true
HAWKI_BACKEND_TEXT_INGESTION_ENABLED=true
HAWKI_BACKEND_MANAGED_DOCUMENTS_ENABLED=true
HAWKI_RAG_TEMPORAL_ENABLED=true
HAWKI_RAG_TEMPORAL_SHARED_ROOT=/shared
HAWKI_BACKEND_TEXT_INGESTION_SHARED_ROOT=/shared
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
QDRANT_HTTP_URL=http://qdrant:6333
QDRANT_API_KEY=
NEO4J_URI=bolt://hawki_rag_neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
EXTERNAL_SCRAPER_URL=
EXTERNAL_SCRAPER_TOKEN=
HAWKI_RAG_WORKER_CALLBACK_URL=http://hawki_backend/internal/pipeline/worker-events
HAWKI_RAG_WORKER_CALLBACK_SECRET=
HAWKI_RAG_WORKER_CALLBACK_MAX_AGE_SECONDS=300
HAWKI_QUERY_BACKEND=python
TEXT_INGESTION_BACKEND=python
MANAGED_DOCUMENT_BACKEND=python
CRAWLER_INGESTION_BACKEND=python
PIPELINE_EXECUTION_BACKEND=python
DATASET_BACKEND=python
GRAPH_OPS_BACKEND=python
HAWKI_RAG_QUERY_ALL_DATASETS_BY_DEFAULT=false

# Imported archived rows must not advance before legacy ownership disposition.
# Enable background cleanup only after the separately approved handoff.
HAWKI_BACKEND_DATASET_CLEANUP_ENABLED=false

HAWKI_BACKEND_SERVICE_ONLY=true
HAWKI_BACKEND_LARAVEL_OFF=true
HAWKI_BACKEND_URL_RECONCILE_ENABLED=true
HAWKI_RAG_UI_ORIGIN=http://localhost:8080
# Default HAWKI approval; the explicit loopback local overlay selects local.
HAWKI_RAG_UI_ACCESS_MODE=hawki
# HAWKI must authorize RAG management for this service/tenant: 204 allow, 401/403 deny.
HAWKI_RAG_UI_AUTHORIZATION_URL=
# Provision this external directory; never commit its contents or generate keys here.
# Supply access.jwt, rotated by the issuer, OR client.secret for OAuth below.
HAWKI_RAG_UI_CREDENTIAL_DIR=
# Optional client-credentials exchange against the existing issuer; HTTPS required.
HAWKI_RAG_UI_TOKEN_URL=
HAWKI_RAG_UI_CLIENT_ID=rag-management
HAWKI_RAG_UI_SCOPES=rag:query rag:ingest rag:datasets:manage

# Enable only when deployment-managed custom converter defaults are intended.
HAWKI_BACKEND_CUSTOM_UPLOADS_ENABLED=false
