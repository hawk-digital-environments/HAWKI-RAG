# Settings for the local development overlay.
TEMPORAL_CLIENT_IDENTITY=hawki-rag-python-local
SSL_CERT_FILE=/run/local-auth/ca-bundle.pem
RAG_BACKEND_URL_INGESTION_ENABLED=${RAG_BACKEND_URL_INGESTION_ENABLED:-false}
RAG_BACKEND_MANAGED_DOCUMENTS_ENABLED=true
RAG_BACKEND_TEXT_INGESTION_ENABLED=true
RAG_BACKEND_DATASET_GRAPH_ENABLED=true
RAG_BACKEND_HISTORICAL_ARCHIVE_ROOT=/shared/.historical-orphans
