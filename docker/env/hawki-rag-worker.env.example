# RabbitMQ worker env example

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
RABBITMQ_EXCHANGE=jobs
RABBITMQ_RETRY_EXCHANGE=jobs.retry
RABBITMQ_FAILED_EXCHANGE=jobs.failed
RABBITMQ_MAIN_QUEUE=crawl_jobs
RABBITMQ_RETRY_QUEUE=crawl_jobs_retry
RABBITMQ_FAILED_QUEUE=failed_jobs
RABBITMQ_MAIN_ROUTING_KEY=crawl
RABBITMQ_RETRY_ROUTING_KEY=crawl.retry
RABBITMQ_FAILED_ROUTING_KEY=crawl.failed
RABBITMQ_RETRY_DELAY_MS=5000
RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_MAX_RETRIES=3
RABBITMQ_QUEUE_TYPE=quorum
RABBITMQ_RETRY_QUEUE_TYPE=classic
RABBITMQ_SHUTDOWN_GRACE_SECONDS=30
RABBITMQ_JOB_DB_PATH=/app/storage/app/private/rag_worker_jobs.sqlite

