# Phase A overlay ONLY. Merge into a reviewed external deployment environment.
# Do not copy this over .env or use it as the complete Compose environment.
# Admission remains paused. Retain the deployment's current query-all policy
# until exact grants have been reviewed and materialized.
HAWKI_QUERY_BACKEND=laravel
TEXT_INGESTION_BACKEND=laravel
MANAGED_DOCUMENT_BACKEND=laravel
CRAWLER_INGESTION_BACKEND=laravel
PIPELINE_EXECUTION_BACKEND=laravel
DATASET_BACKEND=laravel
GRAPH_OPS_BACKEND=laravel
# Keep callback ingress on Laravel and control automatic legacy retry admission
# through the approved operation process. These values do not disable a scheduler.

# Imported archived rows must not advance before legacy ownership disposition.
# Enable background cleanup only after the separately approved handoff.
HAWKI_BACKEND_DATASET_CLEANUP_ENABLED=false
