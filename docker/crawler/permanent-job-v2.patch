+def receipt_schema(schema: dict) -> None:
+    # This annotation is optional; the consumer requires an exact nullable timestamp.
+    schema["properties"]["sealed_at"].pop("title", None)
+
+
+class CrawlReceipt(BaseModel):
+    """A terminal receipt is sealed only after all job writers have drained."""
+
+    model_config = ConfigDict(extra="allow", json_schema_extra=receipt_schema)
+
+    job_id: JobId
+    external_job_id: JobId
+    status: LifecycleState
+    state: LifecycleState
+    terminal: StrictBool
+    sealed: StrictBool
+    sealed_at: AwareDatetime | None
+    quiescent: StrictBool
+    writer_admission_closed: StrictBool
+    output_directory: str = Field(min_length=1)
+    metadata: CrawlOwnership
+    pages_crawled: int = Field(ge=0)
+
+    @model_validator(mode="after")
+    def consistent(self) -> "CrawlReceipt":
+        terminal = self.status in {"completed", "failed", "cancelled"}
+        if (
+            self.job_id != self.external_job_id
+            or self.state != self.status
+            or self.terminal != terminal
+        ):
+            raise ValueError("Inconsistent permanent job identity or state")
+        if self.sealed and not (
+            terminal and self.quiescent and self.writer_admission_closed and self.sealed_at
+        ):
+            raise ValueError("Sealed job lacks drainage evidence")
+        return self
 
 
