# ==============================================================================
# Local Ollama mode — deltas to apply to .env
# ==============================================================================
# The base .env.example assumes an external LiteLLM gateway. Copy the active
# lines below into .env (replacing the gateway values) to run every model on
# the local Ollama addon instead:
#
#   1. Apply these deltas to .env.
#   2. Start the stack with the addon included (the default):
#        make up-core                # WITH_OLLAMA=1 is the default
#      A gateway-only stack omits it: make up-core WITH_OLLAMA=0
#
# Mixed setups work without switching the provider: keep RAG_PROVIDER=litellm
# and give only some models ollama-prefixed names (e.g. chat/vision locally
# via ollama_chat/..., embeddings via a bare gateway alias).
#
# Revert by restoring the gateway values.

RAG_PROVIDER=ollama
LITELLM_API_URL=                      # unused with RAG_PROVIDER=ollama

EMBED_MODEL=ollama/bge-m3
CHAT_MODEL=ollama_chat/llama3.1:8b
VISION_MODEL=ollama_chat/qwen2.5vl:7b
GRAPH_EMBEDDING_DIMENSIONS=ollama/bge-m3=1024
