# ==============================================================================
# LiteLLM gateway mode — deltas to apply to .env
# ==============================================================================
# Copy the active lines below into .env (replacing the ollama defaults),
# start the gateway with `make up-gateway`, and recreate the Python services
# (for example `make up-core`) so they pick up the changed .env.
#
# The gateway renders its routes at container startup from the canonical
# model keys (EMBED/CHAT/VISION_MODEL plus the plural allowlists); nothing
# else changes. Revert by restoring the ollama values and `make down-gateway`.

RAG_PROVIDER=litellm

# Optional: real proxy credentials. Without a key the gateway boots with the
# shared internal placeholder (sk-noauth) and the Python client sends the
# same value, so the default needs no configuration.
#LITELLM_API_KEY=sk-change-me

# Optional hosted menu entries: they appear in Settings and as gateway
# routes, and need OPENAI_API_KEY / ANTHROPIC_API_KEY in .env to serve
# traffic (routes without a key fail closed).
#CHAT_MODELS=ollama_chat/llama3.1:8b,openai/gpt-4.1-mini,anthropic/claude-sonnet-4-5-20250929
#EMBED_MODELS=ollama/bge-m3,openai/text-embedding-3-small
#VISION_MODELS=ollama_chat/qwen2.5vl:7b,openai/gpt-4.1-mini

# Quick verification against the running gateway:
#   make gateway-smoke
