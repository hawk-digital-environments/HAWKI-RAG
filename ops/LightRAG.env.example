# LightRAG production template for Qdrant + Jina reranker + text-embedding-3-large

ENV=production
LOG_LEVEL=info

# Vector DB: Qdrant (shared external network)
VECTOR_DB=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=embeddings_hawk
QDRANT_DISTANCE=Cosine

HOST=0.0.0.0
PORT=9621
WEBUI_TITLE='My Graph KB'
WEBUI_DESCRIPTION="Simple and Fast Graph Based RAG System"
LOG_LEVEL=INFO
MAX_ASYNC=4
MAX_PARALLEL_INSERT=2

# Reranking (local Cohere-compatible service)
RERANK_BINDING=cohere
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BINDING_HOST=http://lightrag_rerank:8000/v1/rerank
# RERANK_BINDING_API_KEY=

# LLM via GWDG (OpenAI-compatible)
LLM_BINDING=openai
LLM_MODEL=llama-3.3-70b-instruct
LLM_BINDING_HOST=https://chat-ai.academiccloud.de/v1
LLM_BINDING_API_KEY=0a03a662ec70b688f933708c15fa3a28
OPENAI_LLM_MAX_COMPLETION_TOKENS=9000

# Embeddings via Ollama (running in main compose on the same external network)
EMBEDDING_BINDING=ollama
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_DIM=1024
# The service name is 'ollama' on the shared hawki-network
EMBEDDING_BINDING_HOST=http://ollama:11434

# Qdrant (vector DB) and Neo4j (KG)
QDRANT_URL=http://qdrant:6333
NEO4J_URI=bolt://neo4j:7687
# Both variables are kept for compatibility across services
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Configure LightRAG storages (vector/KV/doc status defaults preserved)
LIGHTRAG_VECTOR_STORAGE=QdrantVectorDBStorage
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
WORKSPACE=demo
COSINE_THRESHOLD=0.2

# Reranker (recommended, mix mode)
RERANKER_PROVIDER=jina
JINA_API_KEY=
JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual
QUERY_MODE=mix

# Knowledge Graph (Neo4j)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Optional auth for LightRAG server
API_KEY=

# If LightRAG supports Ollama directly (optional)
OLLAMA_API_URL=http://ollama:11434/api
