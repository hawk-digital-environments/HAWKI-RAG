# Configuration for the Python query backend (hawki_backend).
#
# This file documents the keys only. The application does not load a .env
# file itself; the deployment injects these variables (the compose stack uses
# the shared env_file). Never commit real credentials.
#
# Every value below is a placeholder. Copy the keys into the deployment
# environment and replace the placeholders there.
# Leave a HAWKI_BACKEND_* group entirely unset when it is not configured;
# a partial or invalid group prevents startup, while /v1/query fails closed
# when its required configuration is absent.

# ---------------------------------------------------------------------------
# Authentication boundary (fail-closed)
#
# When none of these variables is present the application starts without an
# authentication boundary and /v1/query answers 503. When any of them is
# present the whole configuration must be valid or the application refuses to
# start. There is no anonymous mode.
# ---------------------------------------------------------------------------
HAWKI_BACKEND_AUTH_ISSUER=https://issuer.example.invalid
HAWKI_BACKEND_AUTH_AUDIENCE=hawki-backend
HAWKI_BACKEND_AUTH_JWKS_URL=https://issuer.example.invalid/.well-known/jwks.json
HAWKI_BACKEND_AUTH_CLIENTS={"hawki-console":"user","hawki-bff":"user"}
HAWKI_BACKEND_AUTH_ALGORITHMS=RS256,ES256
HAWKI_BACKEND_AUTH_TENANT_CLAIM=tenant_id
HAWKI_BACKEND_AUTH_LEEWAY_SECONDS=30
HAWKI_BACKEND_AUTH_MAX_TOKEN_TTL_SECONDS=3600
HAWKI_BACKEND_AUTH_JWKS_CACHE_TTL_SECONDS=600
HAWKI_BACKEND_AUTH_JWKS_MIN_REFRESH_SECONDS=60
HAWKI_BACKEND_AUTH_JWKS_MAX_STALE_SECONDS=3600
HAWKI_BACKEND_AUTH_JWKS_TIMEOUT_SECONDS=3
HAWKI_BACKEND_AUTH_JWKS_MAX_BYTES=524288

# ---------------------------------------------------------------------------
# Persistence boundary (tenant-scoped grant store)
#
# Use an account that can only reach the hawki_backend schema. The runtime
# never reads the application's public schema.
# ---------------------------------------------------------------------------
HAWKI_BACKEND_DB_DSN=postgresql+psycopg://USER:PASSWORD@postgres:5432/hawki_rag
HAWKI_BACKEND_DB_POOL_SIZE=5
HAWKI_BACKEND_DB_POOL_TIMEOUT_SECONDS=3
HAWKI_BACKEND_DB_POOL_RECYCLE_SECONDS=300
HAWKI_BACKEND_DB_CONNECT_TIMEOUT_SECONDS=3
HAWKI_BACKEND_DB_STATEMENT_TIMEOUT_MS=2000

# ---------------------------------------------------------------------------
# Server-owned query scope registry
#
# DATASETS maps each dataset id to qdrant_collection, embedding_provider,
# embedding_model, graph_enabled and (when graph is enabled) neo4j_namespace.
# MODELS maps each embedding provider to chat_model and vision_model.
# embedding_model belongs in DATASETS. The values are deployment data,
# never client input. This registry is migration-time configuration, not
# a lookup into Laravel's public tables.
# ---------------------------------------------------------------------------
HAWKI_BACKEND_QUERY_DATASETS={"dataset-example":{"qdrant_collection":"dataset_example","embedding_provider":"ollama","embedding_model":"example-embedding","graph_enabled":false}}
HAWKI_BACKEND_QUERY_MODELS={"ollama":{"chat_model":"example-chat","vision_model":"example-vision"}}
HAWKI_BACKEND_QUERY_RERANKER=none
HAWKI_BACKEND_QUERY_RERANK_TOP_N=20
HAWKI_BACKEND_QUERY_RERANKER_MIX_MODE=true
HAWKI_BACKEND_QUERY_RERANKER_MIX_WEIGHT=0.5

# ---------------------------------------------------------------------------
# Dataset authority (Epoch 12, opt-in)
#
# The default remains the environment registry above. Select `database` only
# after revision 0007 and the reviewed dataset-authority import are complete.
# Database mode requires HAWKI_BACKEND_DB_DSN and forbids
# HAWKI_BACKEND_QUERY_DATASETS; remove or comment that key out when switching.
# The embedding defaults below seed new datasets created through Python; the
# review step in scripts/dataset_authority.py replaces imported placeholders.
# ---------------------------------------------------------------------------
# HAWKI_BACKEND_QUERY_DATASET_SOURCE=database
HAWKI_BACKEND_DATASET_EMBEDDING_PROVIDER=ollama
HAWKI_BACKEND_DATASET_EMBEDDING_MODEL=bge-m3

# ---------------------------------------------------------------------------
# Shared retrieval configuration
#
# These variables are read by the shared hawki_rag_retrieval package, not by
# the backend's own settings. They must carry the same effective values that
# hawki_bridge receives, so both query paths execute the same pipeline.
# They are listed here as documentation only; do not copy defaults into the
# deployment, copy the values hawki_bridge actually runs with.
# ---------------------------------------------------------------------------
# Generation and pipeline behaviour
#   RAG_GENERATE_ANSWER
#   RAG_FUSION_SEM_WEIGHT
#   RAG_FUSION_STR_WEIGHT
#   RAG_MIN_SCORE
#   RAG_MIN_SCORE_FALLBACK
#   RAG_CONTEXT_TOKENS
#   RAG_CONTEXT_DOCS
#   RAG_ITERATIVE_RETRIEVAL
#   RAG_STRUCTURAL_LIMIT
#   RAG_STRUCTURAL_HOPS
#   RAG_GRAPH_TERMS_PER_HIT
#   RAG_GRAPH_TERM_LIMIT
#   RAG_SEARCH_TOP_K_MULT
#   RAG_SEARCH_TOP_K_CAP
#   RAG_EXHAUSTIVE_TEXT
#   QDRANT_TEXT_SCROLL_LIMIT
#
# Vector store
#   QDRANT_SCHEME
#   QDRANT_HOST
#   QDRANT_PORT
#   QDRANT_API_KEY
#   QDRANT_TIMEOUT
#   QDRANT_UPSERT_TIMEOUT
#   QDRANT_SEARCH_TIMEOUT
#   QDRANT_COUNT_TIMEOUT
#   QDRANT_DELETE_TIMEOUT
#
# Graph store
#   NEO4J_URI
#   NEO4J_USER
#   NEO4J_PASSWORD
#   NEO4J_DATABASE
#   NEO4J_MAX_TRANSACTION_RETRY_TIME
#
# Reranker
#   RERANKER_API_URL
#   RERANKER_API_KEY
#   JINA_API_KEY
#   JINA_RERANKER_MODEL
#   (the bridge's RERANKER_MODE maps to HAWKI_BACKEND_QUERY_RERANKER above)
#
# Provider endpoints and model aliases (must match the values hawki_bridge and
# the Laravel settings resolve for the same deployment)
#   LITELLM_API_URL
#   LITELLM_CHAT_MODEL
#   LITELLM_EMBED_MODEL
#   LITELLM_VISION_MODEL
#   OLLAMA_API_URL
#   OLLAMA_RAG_MODEL
#   OLLAMA_EMBED_MODEL
#   OLLAMA_VISION_MODEL

# Internal workflow control is independent of public JWT/query configuration.
# Enable only after migration 0002 and the coordinated control-plane handoff.
HAWKI_WORKFLOW_CONTROL_ENABLED=false
HAWKI_RAG_WORKER_CALLBACK_SECRET=
