## Website scraper

# Copy to .env.scraper next to .env and include the addon after the base file.
# deploy.sh automatically loads the fragment.
# COMPOSE_FILE=docker-compose.yml:docker-compose.scraper.yml ./deploy.sh
RAG_SCRAPER_IMAGE=digitalenvironments/hawki-rag-scraper:latest

# The Temporal scraper worker reaches the addon at its Docker service name.
CUSTOM_CRAWLER_URL=http://scraper
CUSTOM_CRAWLER_TASK_UI_URL=${CUSTOM_CRAWLER_URL}
EXTERNAL_SCRAPER_URL=${CUSTOM_CRAWLER_URL}

# Set the public origin if you serve the UI through a reverse proxy.
# The scraper publishes no host port.
ORIGIN=https://scraper.example.com

# Shared artifact path on the HAWKI-RAG side.
SCRAPE_STORAGE_PATH=${SHARED_STORAGE_ROOT:-/shared}

# Enable RAG_BACKEND_URL_INGESTION_ENABLED in the base .env after verifying
# that the selected image implements permanent-job-v2.
