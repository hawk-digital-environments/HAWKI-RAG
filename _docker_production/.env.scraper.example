# Copy to .env.scraper and pass --env-file .env.scraper after --env-file .env.
# Include docker-compose.scraper.yml after the base file.
# Required. The image must run hawki_crawler.app.main:app with the current
# permanent-job-v2 API and connection-bound Linux browser isolation. Current
# RAWKI workflows do not publish this image.
HAWKI_RAG_SCRAPER_IMAGE=

# The addon sets the internal crawler URL and enables URL ingestion. It uses
# the base PUID/PGID and rawki_shared_storage. The local crawler has no host port.
# Historical scraper volumes and the legacy saved task/profile store require an
# explicit compatibility handoff. Keep them for that handoff.
