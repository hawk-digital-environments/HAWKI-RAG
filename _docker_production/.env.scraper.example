# Copy to .env.scraper and include docker-compose.scraper.yml after the base.
# COMPOSE_FILE=docker-compose.yml:docker-compose.scraper.yml ./deploy.sh
# Select a tag or digest available to your deployment.
RAG_SCRAPER_IMAGE=digitalenvironments/hawki-rag-scraper:latest
# Origin used by the image's UI. The addon publishes no host port.
# RAG_SCRAPER_ORIGIN=http://scraper
# The backend and worker use http://scraper on the crawler network.
# Enable URL ingestion in the base .env only after verifying permanent-job-v2.
