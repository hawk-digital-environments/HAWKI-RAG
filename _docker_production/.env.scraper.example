## ============================================================
## Fragment: Website scraper
## ============================================================

# Activate by copying to .env.scraper next to .env AND adding the addon
# compose file (deploy.sh picks the fragment up automatically; see
# .env.example):
#   COMPOSE_FILE=docker-compose.yml:docker-compose.scraper.yml ./deploy.sh
# The scraper container publishes no host port; serve its UI through the
# HAWKI stack's reverse proxy and set ORIGIN below to that public URL.

# Crawler endpoint the Laravel clients and the scraper worker use; the
# service name of the in-stack addon container.
CUSTOM_CRAWLER_URL=http://scraper
CUSTOM_CRAWLER_TASK_UI_URL=${CUSTOM_CRAWLER_URL}
EXTERNAL_SCRAPER_URL=${CUSTOM_CRAWLER_URL}
# Public reverse-proxy URL the scraper's SvelteKit UI validates browser
# Origin headers against - never a container-internal name.
ORIGIN=https://scraper.example.com

# Where the pipeline shared-storage health check expects the crawl-data root;
# follows the core anchor. (The worker's actual storage root travels in the
# workflow payload from HAWKI_RAG_TEMPORAL_SHARED_ROOT; SCRAPE_DEFAULT_* and
# SCRAPE_ALLOWED_LOCAL_ROOTS stay unset because their code defaults already
# match the values above or derive from the same anchors - see the
# documentation.)
SCRAPE_STORAGE_PATH=${SHARED_STORAGE_ROOT}
