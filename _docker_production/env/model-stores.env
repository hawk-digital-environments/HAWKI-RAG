# Compose resolves these settings from the production project env.
QDRANT_HTTP_URL=${QDRANT_HTTP_URL:-http://qdrant:6333}
QDRANT_API_KEY
NEO4J_URI=${NEO4J_URI:-bolt://neo4j:7687}
NEO4J_USER=${NEO4J_USER:-neo4j}
NEO4J_PASSWORD=${NEO4J_PASSWORD:?Set NEO4J_PASSWORD}
NEO4J_DATABASE=${NEO4J_DATABASE:-neo4j}
LITELLM_API_URL
LITELLM_API_KEY
LITELLM_CHAT_TIMEOUT
LITELLM_EMBED_TIMEOUT
OLLAMA_API_URL
OLLAMA_CHAT_TIMEOUT
OLLAMA_NUM_PREDICT
