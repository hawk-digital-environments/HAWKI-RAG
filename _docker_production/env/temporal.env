# Compose resolves these settings from the production project env.
DB=postgres12
DB_PORT=5432
POSTGRES_SEEDS=postgres
POSTGRES_USER=${DB_USERNAME:-rag_user}
POSTGRES_PWD=${DB_PASSWORD:?Set DB_PASSWORD}
BIND_ON_IP=0.0.0.0
DEFAULT_NAMESPACE=${TEMPORAL_NAMESPACE:-default}
DBNAME
VISIBILITY_DBNAME
DEFAULT_NAMESPACE_RETENTION
SKIP_SCHEMA_SETUP
SKIP_DB_CREATE
TZ=${TZ:-Europe/Berlin}
