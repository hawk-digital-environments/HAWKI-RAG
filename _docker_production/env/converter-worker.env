# Compose resolves these settings from the production project env.
TEMPORAL_RAG_HTTP_TIMEOUT_SECONDS
TEMPORAL_RAG_HTTP_RETRY_ATTEMPTS
TEMPORAL_RAG_EXTERNAL_POLL_INTERVAL_SECONDS
TEMPORAL_RAG_EXTERNAL_POLL_TIMEOUT_SECONDS
EXTERNAL_CONVERTER_URL=${EXTERNAL_CONVERTER_URL:-${FILE_CONVERTER_BASE_URL:-http://file-converter}}
EXTERNAL_CONVERTER_TOKEN=${EXTERNAL_CONVERTER_TOKEN:-${FILE_CONVERTER_TOKEN:?Set FILE_CONVERTER_TOKEN}}
