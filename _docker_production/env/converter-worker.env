EXTERNAL_CONVERTER_STATUS_PATH
TEMPORAL_RAG_CONVERTER_TASK_QUEUE=${TEMPORAL_RAG_CONVERTER_TASK_QUEUE:-rawki-python-converter}
RAG_TEMPORAL_CONVERTER_LOG_PATH
