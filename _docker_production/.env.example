## ============================================================
## Docker Compose and Container Adapters
## ============================================================

# Compose reads this file once and injects it into every configured service.
HAWKI_RAG_COMPOSE_ENV_FILE=.env

# Host identity used for shared-volume ownership.
PUID=33
PGID=33
PIPELINE_SHARED_STORAGE_UID=${PUID}
PIPELINE_SHARED_STORAGE_GID=${PGID}

# Laravel image build and reverse-proxy metadata.
DOCKER_SERVICE_PROTOCOL=http
DOCKER_PROJECT_HOST=localhost:8080
DOCKER_PROJECT_PATH=/
DOCKER_PROJECT_PROTOCOL=http
VIRTUAL_HOST=${DOCKER_PROJECT_HOST}
VIRTUAL_PATH=${DOCKER_PROJECT_PATH}
VIRTUAL_DEST=/
NGINX_CLIENT_MAX_BODY_SIZE=128M
PHP_POST_MAX_SIZE=128M
PHP_UPLOAD_MAX_FILESIZE=128M

# Adapter names required by the PostgreSQL and Temporal images. Credentials
# reference the canonical DB_* values instead of duplicating their contents.
POSTGRES_DB=${DB_DATABASE}
POSTGRES_USER=${DB_USERNAME}
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_PWD=${DB_PASSWORD}
POSTGRES_SEEDS=postgres
DB=postgres12
BIND_ON_IP=0.0.0.0
DEFAULT_NAMESPACE=${TEMPORAL_NAMESPACE}
TZ=Europe/Berlin
TEMPORAL_CORS_ORIGINS=${TEMPORAL_UI_CORS_ORIGINS}

# Internal service addresses and PostgreSQL-backed monitor retention.
NEO4J_AUTH=${NEO4J_USER}/${NEO4J_PASSWORD}
NEO4J_URI=bolt://hawki_rag_neo4j:7687
HAWKI_RAG_MONITOR_RETENTION_DAYS=30
HAWKI_RAG_WORKER_CALLBACK_URL=http://hawki_rag_app/api/internal/pipeline/worker-events
HAWKI_RAG_TEMPORAL_SCRAPER_LOG_PATH=/shared/logs/scraper_worker.log
HAWKI_RAG_TEMPORAL_CONVERTER_LOG_PATH=/shared/logs/converter_worker.log
HAWKI_RAG_TEMPORAL_INDEXER_LOG_PATH=/shared/logs/indexer_worker.log

# Container image/runtime settings previously defaulted in Compose.
GPU_MIN_FREE_MB=4096
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable
