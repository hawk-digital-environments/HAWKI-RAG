# Copy to .env and supply the required values. Pass addon fragments as
# additional --env-file options if used, with the base file first.
# Keep the existing Compose project name so the database volumes are reused.
# Validate from this directory with docker compose --env-file .env config --quiet.

## 1. Required deployment settings

# Use images built from the same Python production release. The repository and
# version combine with historical worker/reranker tag prefixes. The current
# test workflows do not publish these Python-era images. Supply full published
# references for the backend and frontend (tag or digest) once available.
HAWKI_RAG_IMAGE_REPOSITORY=digitalenvironments/hawki-rag
HAWKI_RAG_VERSION=
HAWKI_BACKEND_IMAGE=
HAWKI_RAG_FRONTEND_IMAGE=

# The host TLS reverse proxy can use loopback. A containerized proxy can join
# the Compose-owned hawki-rag-network and use hawki_rag_frontend:80. Keep all
# proxy upstreams pointed at the frontend so /internal remains unreachable.
HAWKI_RAG_HTTP_BIND=127.0.0.1
HAWKI_RAG_HTTP_PORT=8080

## 2. Database and persistence

# Existing installs must retain the existing database name, login and password.
# DB_PASSWORD is a secret used by the PostgreSQL image and Temporal bootstrap.
DB_DATABASE=hawki_rag
DB_USERNAME=rag_user
DB_PASSWORD=
TEMPORAL_NAMESPACE=default
# Optional Temporal persistence overrides. Preserve the existing database names.
# DBNAME=temporal
# VISIBILITY_DBNAME=temporal_visibility
# DEFAULT_NAMESPACE_RETENTION=24h
# SKIP_SCHEMA_SETUP=false
# SKIP_DB_CREATE=false

# Required secret. Provision a separate backend runtime login and Alembic
# revision 0009 before startup. The login needs the runtime grants checked by
# readiness, with no DDL, schema ownership or access to historical public tables.
# Use postgresql+psycopg://<runtime-role>:<encoded-password>@postgres:5432/hawki_rag
HAWKI_BACKEND_DB_DSN=
HAWKI_BACKEND_DB_POOL_SIZE=5
HAWKI_BACKEND_DB_POOL_TIMEOUT_SECONDS=3
HAWKI_BACKEND_DB_POOL_RECYCLE_SECONDS=300
HAWKI_BACKEND_DB_CONNECT_TIMEOUT_SECONDS=3
HAWKI_BACKEND_DB_STATEMENT_TIMEOUT_MS=2000

# Optional. By default both stores are reachable only on the project network.
# To enable local Qdrant authentication, set the server secret and use the same
# secret (or a valid scoped key) for each client. The /readyz probe needs no key.
QDRANT_HTTP_URL=http://qdrant:6333
# QDRANT__SERVICE__API_KEY=
# QDRANT_API_KEY=
# Text ingestion defaults to the main Qdrant endpoint and key.
# HAWKI_BACKEND_TEXT_INGESTION_QDRANT_URL=http://qdrant:6333
# HAWKI_BACKEND_TEXT_INGESTION_QDRANT_API_KEY=
NEO4J_URI=bolt://hawki_rag_neo4j:7687
NEO4J_USER=neo4j
NEO4J_DATABASE=neo4j
NEO4J_PASSWORD=
# NEO4J_HTTP_URL=http://hawki_rag_neo4j:7474

## 3. Authentication and authorization

# Required public issuer/JWKS metadata and readiness key ID. Supply the real
# issuer and key ID. The live JWKS probe checks an RS256 key.
HAWKI_BACKEND_AUTH_ISSUER=
HAWKI_BACKEND_AUTH_AUDIENCE=hawki-backend
HAWKI_BACKEND_AUTH_JWKS_URL=
HAWKI_BACKEND_READINESS_JWKS_KEY_ID=
HAWKI_BACKEND_AUTH_ALGORITHMS=RS256
# Register actual issuer service client IDs. Dataset grants are provisioned in
# the backend database per tenant/service. Leave HAWKI_BACKEND_QUERY_DATASETS absent.
HAWKI_BACKEND_AUTH_CLIENTS='{"hawki-service":"service","rag-management":"service"}'
# HAWKI_BACKEND_AUTH_TENANT_CLAIM=tenant_id
# HAWKI_BACKEND_AUTH_LEEWAY_SECONDS=30
# HAWKI_BACKEND_AUTH_MAX_TOKEN_TTL_SECONDS=3600

# Compose enforces HAWKI_BACKEND_REQUIRE_READY_SCHEMA=true,
# HAWKI_BACKEND_SERVICE_ONLY=true and HAWKI_BACKEND_LARAVEL_OFF=true.
# The last flag fences legacy deletion dispatch/receipts. Dataset cleanup
# remains disabled pending the approved historical ownership handoff.
# HAWKI_BACKEND_HISTORICAL_ARCHIVE_ROOT=/shared/.historical-orphans

## 4. Internal service authentication

# Required shared HMAC secret for the backend and three activity workers.
# Compose routes callbacks to http://hawki_backend/internal/pipeline/worker-events.
HAWKI_RAG_WORKER_CALLBACK_SECRET=
HAWKI_RAG_WORKER_CALLBACK_MAX_AGE_SECONDS=300
# HAWKI_RAG_WORKER_CALLBACK_TIMEOUT_SECONDS=10
# HAWKI_RAG_WORKER_CALLBACK_RETRY_ATTEMPTS=3

# Required exact HTTPS origin (no trailing slash) and HAWKI authorization URL.
# The gateway forwards the HAWKI session cookie to this trusted endpoint.
# It needs HTTP 204 approval for the applicable management action and tenant.
HAWKI_RAG_UI_ORIGIN=
HAWKI_RAG_UI_AUTHORIZATION_URL=
# Create the directory yourself, readable by the gateway's runtime UID/GID.
# Mount access.jwt for issuer-rotated service JWTs, or client.secret with the
# HTTPS token endpoint below. Source both credentials from the real issuer.
HAWKI_RAG_UI_CREDENTIAL_DIR=./.secrets/ui-service
# HAWKI_RAG_UI_TOKEN_URL=https://issuer.example.org/token
HAWKI_RAG_UI_CLIENT_ID=rag-management
HAWKI_RAG_UI_SCOPES=rag:query rag:ingest rag:datasets:manage
# If needed, place a trusted CA bundle inside the gateway's credential mount.
# SSL_CERT_FILE=/run/ui-service/ca-bundle.pem

## 5. Retrieval and model providers

# Required JSON registry of server-selected generation models by provider.
# Use the route IDs configured in the gateway or the names served by Ollama.
# LiteLLM example: {"litellm":{"chat_model":"hawki-gpt-chat","vision_model":"hawki-gpt-vision"}}
# Ollama example: {"ollama":{"chat_model":"llama3.1:8b","vision_model":"qwen2.5vl:7b"}}
# The current live readiness probe validates Ollama only. LiteLLM configurations
# require a provider-specific readiness implementation before deployment.
HAWKI_BACKEND_QUERY_MODELS=
RAG_GENERATE_ANSWER=true
# These defaults apply to new datasets. Existing datasets keep their provider
# and model. Preserve them unless the dataset has been explicitly reindexed.
HAWKI_BACKEND_DATASET_EMBEDDING_PROVIDER=litellm
HAWKI_BACKEND_DATASET_EMBEDDING_MODEL=hawki-openai-embedding
HAWKI_BACKEND_DATASET_GRAPH_ENABLED=false
# Optional indexer graph dimensions as model=dimension entries.
# GRAPH_EMBEDDING_DIMENSIONS=hawki-openai-embedding=1536,bge-m3=1024
GRAPH_DOC_MAX_CHUNKS=6
GRAPH_DOC_MAX_CHARS=6000
GRAPH_MIN_CHUNK_CHARS=80
GRAPH_MIN_DOC_CHARS=80
MAX_ASYNC=2
MAX_PARALLEL_INSERT=2

# For an external LiteLLM gateway, supply its OpenAI-compatible API base
# (usually ending in /v1), and the externally provisioned bearer key.
LITELLM_API_URL=
LITELLM_API_KEY=
# LITELLM_CHAT_TIMEOUT=240
# LITELLM_EMBED_TIMEOUT=60
# For external Ollama use its reachable /api endpoint. The local addon
# supplies http://ollama:11434/api instead.
# OLLAMA_API_URL=http://ollama.example.org:11434/api
# OLLAMA_NUM_PREDICT=900

# Default local reranker client and server use the same model and optional key.
HAWKI_BACKEND_QUERY_RERANKER=external
HAWKI_BACKEND_QUERY_RERANK_TOP_N=20
RERANKER_API_URL=http://hawki_rag_rerank/v1/rerank
RERANKER_API_DIALECT=hawki-cohere-v1
RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v1
# RERANKER_API_KEY=
# Override the bundled server's model/key separately when using an external reranker.
# HAWKI_RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v1
# HAWKI_RERANKER_API_KEY=
# HF_TOKEN=

## 6. Workers and compatibility services

# The backend, activity workers and optional crawler share /shared.
# Keep the installed storage ownership. PGID supplies the shared storage group.
PUID=33
PGID=33

# Use the same, Python-owned queues for producers and workers. The example
# names are for a new cutover. Preserve already adopted Python queues, and
# fence/drain legacy producers and workers before handing over any old queue.
TEMPORAL_RAG_WORKFLOW_TASK_QUEUE=rawki-python-workflow
TEMPORAL_RAG_SCRAPER_TASK_QUEUE=rawki-python-scraper
TEMPORAL_RAG_CONVERTER_TASK_QUEUE=rawki-python-converter
TEMPORAL_RAG_INDEXER_TASK_QUEUE=rawki-python-indexer
TEMPORAL_RAG_INGESTION_TASK_QUEUE=${TEMPORAL_RAG_INDEXER_TASK_QUEUE}
# TEMPORAL_RAG_ACTIVITY_WORKER_THREADS=4
# TEMPORAL_WORKFLOW_EXECUTION_TIMEOUT=172800
# TEMPORAL_WORKFLOW_RUN_TIMEOUT=86400
# TEMPORAL_WORKFLOW_TASK_TIMEOUT=30
# TEMPORAL_RAG_HTTP_TIMEOUT_SECONDS=1800
# TEMPORAL_RAG_HTTP_RETRY_ATTEMPTS=3
# TEMPORAL_RAG_EXTERNAL_POLL_INTERVAL_SECONDS=5
# TEMPORAL_RAG_EXTERNAL_POLL_TIMEOUT_SECONDS=43200
# CHUNK_SIZE=1200
# CHUNK_OVERLAP_SIZE=250
# INGEST_BATCH_SIZE=64

# Required secret for the bundled converter's Bearer authentication.
FILE_CONVERTER_TOKEN=
EXTERNAL_CONVERTER_URL=http://file-converter
EXTERNAL_CONVERTER_START_PATH=/extract
# FILE_CONVERTER_BASE_URL is a compatibility fallback if the URL above is unset.
# Optional external/async converter configuration.
# EXTERNAL_CONVERTER_TOKEN=
# EXTERNAL_CONVERTER_STATUS_PATH=/jobs/{job_id}
# CUSTOM_CONVERTER_STATUS_PATH=/jobs/{job_id}
# FILE_CONVERTER_SUPPORTED_EXTENSIONS=pdf,docx
HAWKI_BACKEND_CUSTOM_UPLOADS_ENABLED=false

# For an external permanent-job-v2 crawler, set its endpoint and enable URL
# ingestion. The crawler must write into the same shared artifact storage.
# The scraper addon configures its own endpoint and enables URL ingestion.
HAWKI_BACKEND_URL_INGESTION_ENABLED=false
# EXTERNAL_SCRAPER_URL=https://crawler.example.org
# EXTERNAL_SCRAPER_TOKEN=
# CUSTOM_CRAWLER_TASK_UI_URL=https://crawler.example.org

## 7. Optional settings

TZ=Europe/Berlin
# TEMPORAL_UI_HOST_PORT=8081
# TEMPORAL_UI_CORS_ORIGINS=http://127.0.0.1:8081
# HAWKI_RAG_TEMPORAL_SCRAPER_LOG_PATH=/shared/logs/scraper_worker.log
# HAWKI_RAG_TEMPORAL_CONVERTER_LOG_PATH=/shared/logs/converter_worker.log
# HAWKI_RAG_TEMPORAL_INDEXER_LOG_PATH=/shared/logs/indexer_worker.log
