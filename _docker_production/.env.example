## ============================================================
## Required Settings (fill in before the first start)
## ============================================================

# The five secrets below ship without values on purpose: the stack does not
# come up securely (or at all) until they are set. Generate all of them in one
# go with ./generate-env-secrets.sh and paste the printed block over the empty
# values here. Keep the values stable once deployed: a changed APP_KEY makes
# encrypted sessions and stored values unreadable, and new database passwords
# do not rotate the accounts inside existing PostgreSQL/Neo4j volumes.

# Laravel encryption key for sessions and stored values; required, non-rotatable.
APP_KEY=

# PostgreSQL password of the rag_user account (POSTGRES_PASSWORD derives from it).
DB_PASSWORD=

# Neo4j server password (NEO4J_AUTH in the adapter section derives from it).
NEO4J_PASSWORD=

# HMAC secret Laravel and the Python workers use to sign status callbacks.
HAWKI_RAG_WORKER_CALLBACK_SECRET=

# Bearer token Laravel and the converter worker present to the file-converter
# container (compose passes it in as F_API_KEY); must equal EXTERNAL_CONVERTER_TOKEN.
FILE_CONVERTER_TOKEN=
EXTERNAL_CONVERTER_TOKEN=${FILE_CONVERTER_TOKEN}

## ============================================================
## Stack composition (which containers run)
## ============================================================

# Colon-separated list of compose files Docker Compose loads - the base file
# plus one addon file per optional component, IN THIS ORDER (the GPU addon
# requires the Ollama addon before it):
#   docker-compose.yml                          base stack (always first)
#   docker-compose.with-ollama.yml              local Ollama model server
#   docker-compose.with-ollama-and-gpu.yml      GPU for the Ollama server
#   docker-compose.with-litellm.yml             local LiteLLM gateway
#   docker-compose.with-temporal-ui.yml         Temporal web UI
#   docker-compose.scraper.yml                  website scraper
# Compose reads this variable from .env, so ./deploy.sh picks it up; the
# matching env fragment (.env.ollama / .env.litellm / .env.scraper) still
# needs copying next to .env as described below.
COMPOSE_FILE=docker-compose.yml

## ============================================================
## How to assemble the environment
## ============================================================

# 1. cp .env.example .env and fill in the five secrets above.
# 2. Activate the provider/addon fragments you use by copying them next to
#    .env (same name without .example):
#      cp .env.ollama.example  .env.ollama    # model serving via Ollama
#      cp .env.litellm.example .env.litellm   # model serving via a LiteLLM gateway
#      cp .env.scraper.example .env.scraper   # website scraper addon
# 3. ./deploy.sh - it passes .env plus every present fragment to Compose, and
#    every compose service lists the four files in its env_file (optional
#    ones are skipped when absent). ${...} references inside a fragment
#    resolve against the core .env, so SHARED_STORAGE_ROOT works everywhere.
#    When invoking docker compose directly, add each present fragment with
#    --env-file so compose-side interpolations (image tags, ports) see them.
#
# Every variable NOT present in this file or the fragments falls back to a
# code/image default. The complete list - what each variable does, its allowed
# values, its default, and when to set it - lives in the documentation:
# _documentation/Operations/5_environment_db_queue.md

## ============================================================
## Deployment (production only)
## ============================================================

# Version tag every pulled image is pinned to; `latest` follows newest release.
HAWKI_RAG_VERSION=latest
# Docker registry namespace of the stack images (Dokploy: the ghcr.io one).
HAWKI_RAG_IMAGE_REPOSITORY=digitalenvironments/hawki-rag

# Host port the Laravel container publishes for the reverse proxy.
HAWKI_RAG_APP_PORT=8080
# Host interface the published ports bind on.
DOCKER_PROJECT_IP=127.0.0.1

# Host:port browsers use to reach the app; references the port above.
DOCKER_PROJECT_HOST=localhost:${HAWKI_RAG_APP_PORT}
# Base path when serving under a subpath (rare).
DOCKER_PROJECT_PATH=/
# Public protocol; set https behind a TLS-terminating proxy.
DOCKER_PROJECT_PROTOCOL=http

# Public URL Laravel uses for links and callbacks (asset URLs derive from it
# plus DOCKER_PROJECT_PATH; ASSET_URL itself is read by nothing).
APP_URL=${DOCKER_PROJECT_PROTOCOL}://${DOCKER_PROJECT_HOST}${DOCKER_PROJECT_PATH}

## ============================================================
## Application
## ============================================================

# Application name shown in UI, mail, and cache-key slugs.
APP_NAME="HAWKI RAG"
# Maintenance-state store pinned to file (Laravel default: database).
APP_MAINTENANCE_STORE=file

## ============================================================
## PHP, Logging, Runtime Drivers
## ============================================================

# Empty cache-key prefix; unset would fall back to a slug of APP_NAME.
CACHE_PREFIX=

## ============================================================
## Sessions
## ============================================================

# Secure-cookie flag; the code default flips to true when APP_ENV=production -
# this stack terminates TLS upstream, so false is deliberate.
SESSION_SECURE_COOKIE=false
# Destroy the session when the browser closes; code default is false.
SESSION_EXPIRE_ON_CLOSE=true

## ============================================================
## PostgreSQL
## ============================================================

# Host of the postgres container; Laravel default (127.0.0.1) is wrong in-network.
DB_HOST=postgres
# Database and account Laravel connects with; defaults (laravel/root) differ.
DB_DATABASE=hawki_rag
DB_USERNAME=rag_user

## ============================================================
## Shared Storage and Pipeline Paths
## ============================================================

# Root of the shared volume every path here and in the fragments references;
# change it once and the references follow.
SHARED_STORAGE_ROOT=/shared
# Pipeline and crawled-data roots; equal their defaults but follow the anchor.
HAWKI_RAG_PIPELINE_ROOT=${SHARED_STORAGE_ROOT}
HAWKI_RAG_CRAWLED_DATA_ROOT=${SHARED_STORAGE_ROOT}
DEFAULT_CRAWLED_ROOT=${SHARED_STORAGE_ROOT}
# RAG-Anything runtime log on the shared volume; Laravel probes it for the
# operator log view.
HAWKI_RAG_RAGANYTHING_LOG_PATH=${SHARED_STORAGE_ROOT}/logs/raganything_runtime.log
# Legacy note: the pre-Temporal HAWKI_RAG_INGEST_LOG_PATH(+_CACHE/_NEO4J)
# variables were removed - nothing reads them. Laravel probes the
# HAWKI_RAG_TEMPORAL_*_LOG_PATH variables below plus <pipeline
# root>/logs/<stage>_worker.log and /var/www/html/storage/logs/ in the Laravel
# container.

## ============================================================
## Temporal RAG Orchestration
## ============================================================

# Temporal namespace; also feeds DEFAULT_NAMESPACE in the adapter section.
TEMPORAL_NAMESPACE=default
# CORS origins the Temporal server allows; feeds TEMPORAL_CORS_ORIGINS.
TEMPORAL_UI_CORS_ORIGINS=http://localhost:8080
# Workflow-level timeout in seconds; Laravel's own default (86400) is shorter.
TEMPORAL_WORKFLOW_EXECUTION_TIMEOUT=172800
# Single-run timeout in seconds; Laravel's own default (21600) is shorter.
TEMPORAL_WORKFLOW_RUN_TIMEOUT=86400
# Shared root for Temporal artifact hand-off; follows the storage anchor.
HAWKI_RAG_TEMPORAL_SHARED_ROOT=${SHARED_STORAGE_ROOT}

## ============================================================
## File Converter (part of this stack)
## ============================================================

# Base URL of the in-stack file-converter service; the code default wrongly
# assumes port 8000, the container listens on 80.
FILE_CONVERTER_BASE_URL=http://file-converter
# Converter job-status path template; kept explicit because the custom
# variant has no code default.
CUSTOM_CONVERTER_STATUS_PATH=/jobs/{job_id}

## ============================================================
## Python RAG Bridge and Ingest Runtime
## ============================================================

# Single model-runtime switch; no default, missing configuration fails loud.
RAG_PROVIDER=ollama
# Let the bridge synthesize answers with the chat model; the code default is false.
RAG_GENERATE_ANSWER=true
# Chat/embedding gateway endpoint for RAG_PROVIDER=litellm (the Python client
# has no usable default); doubles as the local addon's address.
LITELLM_API_URL=http://litellm:4000/v1
# Bearer token for the gateway; doubles as the local addon's master key
# (current LiteLLM images refuse to boot without one).
LITELLM_API_KEY=
# Trusted model-to-dimension map for graph-only ingestion (no vector response
# to measure); keep in sync with your embedding models.
GRAPH_EMBEDDING_DIMENSIONS=ollama/bge-m3=1024,openai/text-embedding-3-small=1536

## ============================================================
## RAG Models (canonical, provider-prefixed)
## ============================================================

# The prefix routes each request; one set of keys serves every backend. These
# are the Settings UI defaults. With RAG_PROVIDER=litellm every name must be
# resolvable by the gateway; ollama*/ prefixes imply an Ollama server behind
# the gateway's route table. See .env.litellm.example when switching.

# Embedding model for ingestion and queries; pinned per dataset at creation.
EMBED_MODEL=ollama/bge-m3
# Chat model for answer generation and graph extraction defaults.
CHAT_MODEL=ollama_chat/llama3.1:8b
# Vision model describing images during graph ingestion; a name must be set
# (the query contract requires it) even if never invoked.
VISION_MODEL=ollama_chat/qwen2.5vl:7b

## ============================================================
## Qdrant
## ============================================================

# Default collection name; unset makes the Python client auto-pick the most
# populated collection and Laravel's metadata default (embeddings_hawk) differs.
QDRANT_COLLECTION=hawki_docs
# API key when Qdrant requires auth; empty for the in-stack instance.
QDRANT_API_KEY=

## ============================================================
## Neo4j
## ============================================================

# HTTP endpoint of the graph database for Laravel; Python default is empty.
NEO4J_HTTP_URL=http://hawki_rag_neo4j:7474
# Server user; equals its default but NEO4J_AUTH references it.
NEO4J_USER=neo4j
# Database name; deliberately empty (server default) over Laravel's 'neo4j'.
NEO4J_DATABASE=
# Bolt endpoint the Python graph store connects to; its default host (neo4j)
# does not match this stack's container name.
NEO4J_URI=bolt://hawki_rag_neo4j:7687

## ============================================================
## RAG-Anything / LightRAG Graph
## ============================================================

# Cap graph extraction per document; code defaults are unlimited (0/None).
GRAPH_DOC_MAX_CHUNKS=6
GRAPH_DOC_MAX_CHARS=6000
# Skip tiny chunks/documents before extraction; unset (off) is the default.
GRAPH_MIN_CHUNK_CHARS=80
GRAPH_MIN_DOC_CHARS=80
# Concurrent extraction/embedding calls into LightRAG (its own env names;
# library defaults are 4 and 2).
MAX_ASYNC=2
MAX_PARALLEL_INSERT=2
# Generation budget (tokens) for extraction calls; helper default is 900.
OLLAMA_NUM_PREDICT=256
# Removed as inert (no reader in repo code or the LightRAG library):
# GRAPH_STRIP_PIPES, GRAPH_DISABLE_GLEANING, GRAPH_PROMPT_MAX_EXAMPLES,
# KG_MAX_GLEANING, KG_LANGUAGE, KG_ENTITY_TYPES - LightRAG reads the
# unprefixed MAX_GLEANING / SUMMARY_LANGUAGE / ENTITY_TYPES instead; see
# _documentation/Operations/5_environment_db_queue.md before setting those.

## ============================================================
## Reranking and Query
## ============================================================

# Default rerank mode for requests that omit one; code default is none.
RERANKER_MODE=external
# External HTTP reranker endpoint; no code default exists.
RERANKER_API_URL=http://hawki_rag_rerank/v1/rerank
# Direct-Jina credential for RERANKER_MODE=jina; empty otherwise.
JINA_API_KEY=
# To switch backends (local CrossEncoder, LiteLLM SDK reranking via
# RERANKER_MODEL/LITELLM_PROXY_*, direct Jina) see
# _documentation/Operations/5_environment_db_queue.md - those setups need
# variables deliberately not listed here.

## ============================================================
## Search Providers
## ============================================================

# Web-search backend for query-time search; empty default disables it.
WEB_SEARCH_PROVIDER=tavily
# Credential for the selected provider (BRAVE_SEARCH_API_KEY for brave).
TAVILY_SEARCH_API_KEY=

## ============================================================
## MCP
## ============================================================

# URL path the MCP endpoint is served under (auth: sanctum + query ability).
# The other MCP_* variables are wired into config but consumed by nothing.
MCP_SERVER=hawki_rag

## ============================================================
## Mail
## ============================================================

# Sender name for outgoing mail (transport defaults to the log mailer).
MAIL_FROM_NAME="${APP_NAME}"

## ============================================================
## Frontend
## ============================================================

# VITE_APP_NAME was removed: no frontend code reads import.meta.env.VITE_*.

## ============================================================
## Docker Compose and Container Adapters
## ============================================================

# Host identity for shared-volume ownership; compose interpolates PGID with no
# fallback, so both stay set (33 = www-data).
PUID=33
PGID=33
PIPELINE_SHARED_STORAGE_UID=${PUID}
PIPELINE_SHARED_STORAGE_GID=${PGID}

# Upload/body size limits the nginx and PHP images read at runtime.
NGINX_CLIENT_MAX_BODY_SIZE=128M
PHP_POST_MAX_SIZE=128M
PHP_UPLOAD_MAX_FILESIZE=128M

# Adapter variables for the official PostgreSQL and Temporal images.
POSTGRES_DB=${DB_DATABASE}
POSTGRES_USER=${DB_USERNAME}
POSTGRES_PASSWORD=${DB_PASSWORD}
# Temporal auto-setup's view of the same database.
POSTGRES_PWD=${DB_PASSWORD}
POSTGRES_SEEDS=postgres
DB=postgres12
BIND_ON_IP=0.0.0.0
DEFAULT_NAMESPACE=${TEMPORAL_NAMESPACE}
TZ=Europe/Berlin
TEMPORAL_CORS_ORIGINS=${TEMPORAL_UI_CORS_ORIGINS}

# Neo4j container credential (image requires user/password form).
NEO4J_AUTH=${NEO4J_USER}/${NEO4J_PASSWORD}
# Worker callback endpoint; the scraper worker's default is empty, so it stays set.
HAWKI_RAG_WORKER_CALLBACK_URL=http://hawki_rag_app/api/internal/pipeline/worker-events
# Stage runtime logs Laravel probes for the operator views; follow the anchor.
HAWKI_RAG_TEMPORAL_SCRAPER_LOG_PATH=${SHARED_STORAGE_ROOT}/logs/scraper_worker.log
HAWKI_RAG_TEMPORAL_CONVERTER_LOG_PATH=${SHARED_STORAGE_ROOT}/logs/converter_worker.log
HAWKI_RAG_TEMPORAL_INDEXER_LOG_PATH=${SHARED_STORAGE_ROOT}/logs/indexer_worker.log
