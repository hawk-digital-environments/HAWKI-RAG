## ============================================================
## Required Settings (fill in before the first start)
## ============================================================

# The five secrets below ship without values on purpose: the stack does not
# come up securely (or at all) until they are set. Generate all of them in one
# go with
#   ./generate-env-secrets.sh
# and paste the printed block over the empty values here (or into your .env).
# Keep the values stable once deployed: a changed APP_KEY makes encrypted
# sessions and stored values unreadable, and new database passwords do not
# rotate the accounts inside existing PostgreSQL/Neo4j volumes.

# Laravel encryption key: the base64 encoding of 32 random bytes with the
# literal "base64:" prefix.
APP_KEY=

# PostgreSQL password of the rag_user account. The postgres container
# receives it through POSTGRES_PASSWORD, Laravel through DB_PASSWORD.
DB_PASSWORD=

# Password of the Neo4j server user; NEO4J_AUTH in the adapter section
# derives from it.
NEO4J_PASSWORD=

# Shared secret with which Laravel and the Python activity workers sign
# their status callbacks. Workers cannot report progress while it is empty.
HAWKI_RAG_WORKER_CALLBACK_SECRET=

# API token of the file-converter container: Laravel and the converter
# worker present it on every request, and compose passes it to the container
# as F_API_KEY. It must stay identical to EXTERNAL_CONVERTER_TOKEN, which is
# why that line is a ${...} reference (Docker Compose expands references in
# this file; the rules are documented in the file-converter section below).
FILE_CONVERTER_TOKEN=
EXTERNAL_CONVERTER_TOKEN=${FILE_CONVERTER_TOKEN}

## ============================================================
## Deployment (production only)
## ============================================================

# The HAWKI RAG version to deploy. Every image pulled by this stack is pinned
# through this value; `latest` follows the newest release tag. Set it to the
# exact version (matching the Docker Hub tags) for reproducible deployments:
#   laravel-<version>, bridge-<version>, rerank[-gpu]-<version>, ...
#
# Our own servers do not use these public Docker Hub releases: the
# deploy-rag-*.yml workflows build the internal deployment images and push
# them to the GitHub Container Registry as <role>-<environment>-latest
# (e.g. rerank-gpu-prod-latest). A Dokploy deployment therefore sets:
#   HAWKI_RAG_IMAGE_REPOSITORY=ghcr.io/hawk-digital-environments/hawki-rag
#   HAWKI_RAG_VERSION=test-1-latest   # or: prod-latest
HAWKI_RAG_VERSION=latest
HAWKI_RAG_IMAGE_REPOSITORY=digitalenvironments/hawki-rag

# Host port the Laravel application binds to (an external reverse proxy should
# forward its traffic here) and the interface to bind on.
HAWKI_RAG_APP_PORT=8080
DOCKER_PROJECT_IP=127.0.0.1

# Public URL that reaches the application (used for links and callbacks).
# Keep the localhost default only for local trials; behind a TLS-terminating
# reverse proxy set it to the HTTPS URL and SESSION_SECURE_COOKIE (Sessions
# section) to true.
APP_URL=http://localhost:8080

# Ollama models pulled into the stack by the ollama-entrypoint.sh when the
# service starts. The default covers the out-of-the-box embedding, chat,
# graph and vision models; remove models you do not use, especially on
# CPU-only hosts where the vision model is large.
HAWKI_RAG_OLLAMA_MODELS=bge-m3 llama3.1:8b llama3.2:1b qwen2.5vl:7b

## ============================================================
## Application
## ============================================================

# APP_KEY and APP_URL are set in the sections above (required settings and
# deployment).
APP_NAME="HAWKI RAG"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file


## ============================================================
## PHP, Logging, Runtime Drivers
## ============================================================

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=
MEMCACHED_HOST=127.0.0.1
DB_QUEUE_CONNECTION=pgsql
QUEUE_FAILED_DRIVER=database-uuids
DB_CACHE_CONNECTION=pgsql
DB_CACHE_TABLE=cache
DB_CACHE_LOCK_CONNECTION=pgsql
DB_CACHE_LOCK_TABLE=cache_locks


## ============================================================
## Sessions
## ============================================================

SESSION_DRIVER=database
SESSION_CONNECTION=pgsql
SESSION_TABLE=sessions
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=true


## ============================================================
## PostgreSQL and Temporal Persistence
## ============================================================

# DB_PASSWORD is set in the required settings at the top of this file.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hawki_rag
DB_USERNAME=rag_user


## ============================================================
## Shared Storage and Pipeline Paths
## ============================================================

SHARED_STORAGE_ROOT=/shared
PIPELINE_SHARED_STORAGE_WEB_USER=www-data
HAWKI_RAG_PIPELINE_ROOT=/shared
HAWKI_RAG_CRAWLED_DATA_ROOT=/shared
DEFAULT_CRAWLED_ROOT=/shared
HAWKI_RAG_INGEST_LOG_PATH=/var/www/storage/logs/ingest_progress_full.log
HAWKI_RAG_INGEST_LOG_CACHE_PATH=/var/www/storage/logs/ingest_progress_cache.log
HAWKI_RAG_INGEST_LOG_PATH_NEO4J=/var/www/storage/logs/ingest_progress_neo4j_full.log
HAWKI_RAG_INGEST_LOG_CACHE_PATH_NEO4J=/var/www/storage/logs/ingest_progress_neo4j_cache.log
HAWKI_RAG_RAGANYTHING_LOG_PATH=/shared/logs/raganything_runtime.log


## ============================================================
## Temporal RAG Orchestration
## ============================================================

HAWKI_RAG_TEMPORAL_ENABLED=true
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
# The Temporal UI is off by default. Enable it with Compose profile `temporal-ui`.
# Host-side binding only; the container always listens internally on 8080.
TEMPORAL_UI_HOST_BIND=127.0.0.1
TEMPORAL_UI_HOST_PORT=8081
TEMPORAL_UI_CORS_ORIGINS=http://localhost:8080
TEMPORAL_CLIENT_IDENTITY=hawki-rag-laravel
TEMPORAL_INGEST_WORKFLOW_TYPE=IngestSourceWorkflow
TEMPORAL_WORKFLOW_EXECUTION_TIMEOUT=172800
TEMPORAL_WORKFLOW_RUN_TIMEOUT=86400
TEMPORAL_WORKFLOW_TASK_TIMEOUT=30
TEMPORAL_RAG_WORKFLOW_TASK_QUEUE=rag-workflow-task-queue
TEMPORAL_RAG_SCRAPER_TASK_QUEUE=rag-scraper-task-queue
TEMPORAL_RAG_CONVERTER_TASK_QUEUE=rag-converter-task-queue
TEMPORAL_RAG_INGESTION_TASK_QUEUE=rag-ingestion-task-queue
TEMPORAL_RAG_INDEXER_TASK_QUEUE=rag-ingestion-task-queue
TEMPORAL_RAG_DAILY_CRON="0 2 * * *"
TEMPORAL_RAG_WEEKLY_CRON="0 2 * * 0"
TEMPORAL_RAG_MONTHLY_CRON="0 2 1 * *"
TEMPORAL_RAG_HTTP_TIMEOUT_SECONDS=1800
TEMPORAL_RAG_HTTP_RETRY_ATTEMPTS=3
TEMPORAL_RAG_EXTERNAL_POLL_INTERVAL_SECONDS=5
TEMPORAL_RAG_EXTERNAL_POLL_TIMEOUT_SECONDS=43200
HAWKI_RAG_WORKER_CALLBACK_MAX_AGE_SECONDS=300

HAWKI_RAG_TEMPORAL_SHARED_ROOT=/shared

# Set true to ingest source workflows with Neo4j graph extraction enabled.
RAG_INGEST_GRAPH=false

## ============================================================
## File Converter (part of this stack)
## ============================================================

# The file-converter container belongs to this stack (see the compose file),
# so the URLs below simply point at its service name.
#
# ${...} references inside this file are expanded by Docker Compose
# (v2.24+) when it builds the container environments, so every service
# receives the final value. Three rules keep them reliable: a referenced
# variable must be defined EARLIER in this file, single quotes would turn a
# reference into literal text, and plain-text readers of this file (grep
# and friends) see the reference, not the value.

FILE_CONVERTER_BASE_URL=http://file-converter
FILE_CONVERTER_HEALTH_URL=${FILE_CONVERTER_BASE_URL}/health
EXTERNAL_CONVERTER_URL=${FILE_CONVERTER_BASE_URL}
EXTERNAL_CONVERTER_START_PATH=/extract
EXTERNAL_CONVERTER_STATUS_PATH=
CUSTOM_CONVERTER_STATUS_PATH=/jobs/{job_id}
FILE_CONVERTER_SUPPORTED_EXTENSIONS=
FILE_CONVERTER_RETRIES=3


## ============================================================
## Website Scraper (optional - docker-compose.scraper.yml)
## ============================================================

# The scraper worker always runs, but the crawler container is optional:
# deployments that do not scrape websites - or point the worker at an
# external crawler - do not pay for it. It is pulled into this compose
# project through a separate file. To run it inside this stack:
#   1. Start with the override:
#      COMPOSE_FILE=docker-compose.yml:docker-compose.scraper.yml ./deploy.sh
#   2. Uncomment the block below; the URLs then point at the "crawler"
#      service.
# The crawler also inherits PUID/PGID from the adapter section at the end
# of this file, so it writes the shared crawl-data volume with the same
# group as the RAG services. Its crawl API ships without authentication -
# the published port binds to the loopback interface by default, so keep a
# reverse proxy with its own access control in front when exposing it.

# CUSTOM_CRAWLER_URL=http://crawler
# CUSTOM_CRAWLER_TASK_UI_URL=${CUSTOM_CRAWLER_URL}
# EXTERNAL_SCRAPER_URL=${CUSTOM_CRAWLER_URL}
# HAWKI_RAG_SCRAPER_VERSION=latest
# HAWKI_RAG_SCRAPER_IMAGE_REPOSITORY=digitalenvironments/hawki-rag-scraper
# HAWKI_RAG_SCRAPER_PORT=8041
# ORIGIN=http://localhost:8041
# MAX_CONCURRENT_TASKS=5
# DATA_PATH=/var/www/html/shared

# The scraper worker reads the crawled results from the shared volume:
SCRAPE_STORAGE_PATH=/shared
SCRAPE_ALLOWED_LOCAL_ROOTS=/shared
SCRAPE_DEFAULT_MAX_PAGES=100
SCRAPE_DEFAULT_CONCURRENCY=4
SCRAPE_DEFAULT_MAX_RPM=60
SCRAPE_DEFAULT_SKIP_IMAGES=false
SCRAPE_DEFAULT_DISCOVERY_MODE=false


## ============================================================
## Python RAG Bridge and Ingest Runtime
## ============================================================

HAWKI_RAG_BRIDGE_URL=http://hawki_rag_bridge
HAWKI_RAG_QUERY_TIMEOUT=300
HAWKI_RAG_HEALTH_GATE_ENABLED=true
HAWKI_RAG_HEALTH_GATE_TIMEOUT=3
HAWKI_RAG_HEALTH_GATE_REQUIRED=retrieval,graph,pipeline

# Single-user deployments query every current and future active dataset by
# default. Set false to require explicit per-dataset grants.
HAWKI_RAG_QUERY_ALL_DATASETS_BY_DEFAULT=true
SANCTUM_ROUTES=false
SANCTUM_EXPIRATION=null
SANCTUM_TOKEN_PREFIX=hawki_rag_
HAWKI_RAG_CORS_ALLOWED_ORIGINS=

# Direct Ollama is the default runtime. Select `litellm` explicitly in Settings
# and start Compose with `--profile litellm` when gateway routes are needed.
RAG_DEFAULT_PROVIDER=ollama
GRAPH_PROVIDER=ollama
RAG_GENERATE_ANSWER=true
INGEST_BATCH_SIZE=64
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=250
QDRANT_DISTANCE=Cosine

# Optional OpenAI-compatible LiteLLM gateway. Upstream provider keys remain
# deployment secrets and are never returned by Settings.
LITELLM_API_URL=http://litellm:4000/v1
LITELLM_API_KEY=
LITELLM_CHAT_MODEL=hawki-ollama-chat
LITELLM_EMBED_MODEL=hawki-ollama-embedding
LITELLM_VISION_MODEL=hawki-ollama-vision
LITELLM_CHAT_ALIASES=hawki-ollama-chat,hawki-gpt-chat,hawki-claude-chat,hawki-chat
LITELLM_EMBED_ALIASES=hawki-ollama-embedding,hawki-openai-embedding,hawki-embedding
LITELLM_VISION_ALIASES=hawki-ollama-vision,hawki-gpt-vision,hawki-claude-vision,hawki-vision
# Graph-only ingestion has no vector response from which to discover a model's
# dimension. Keep custom LiteLLM aliases synchronized with this trusted map.
GRAPH_EMBEDDING_DIMENSIONS=hawki-ollama-embedding=1024,hawki-openai-embedding=1536,hawki-embedding=1024
LITELLM_CHAT_TIMEOUT=240
LITELLM_EMBED_TIMEOUT=60
LITELLM_PORT=4000

# Local Ollama routes (no upstream API key required).
LITELLM_OLLAMA_API_BASE=http://hawki_ollama:11434
LITELLM_OLLAMA_CHAT_MODEL=ollama_chat/llama3.1:8b
LITELLM_OLLAMA_EMBED_MODEL=ollama/bge-m3
LITELLM_OLLAMA_VISION_MODEL=ollama_chat/qwen2.5vl:7b

# OpenAI routes. Leave OPENAI_API_KEY empty to keep these routes unavailable.
OPENAI_API_KEY=
LITELLM_OPENAI_API_BASE=https://api.openai.com/v1
LITELLM_OPENAI_CHAT_MODEL=openai/gpt-4.1-mini
LITELLM_OPENAI_EMBED_MODEL=openai/text-embedding-3-small
LITELLM_OPENAI_VISION_MODEL=openai/gpt-4.1-mini

# Anthropic has no embeddings route; pair Claude with an Ollama/OpenAI embedder.
ANTHROPIC_API_KEY=
LITELLM_ANTHROPIC_API_BASE=https://api.anthropic.com
LITELLM_ANTHROPIC_CHAT_MODEL=anthropic/claude-sonnet-4-5-20250929
LITELLM_ANTHROPIC_VISION_MODEL=anthropic/claude-sonnet-4-5-20250929


## ============================================================
## Ollama and RAG Models
## ============================================================

OLLAMA_API_URL=http://hawki_ollama:11434/api
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_RAG_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_CHAT_MODELS=llama3.1:8b
OLLAMA_EMBED_MODELS=bge-m3
OLLAMA_VISION_MODELS=qwen2.5vl:7b
OLLAMA_CHAT_TIMEOUT=240
OLLAMA_EMBED_NAN_ZERO_FALLBACK=true

GRAPH_OLLAMA_RAG_MODEL=llama3.1:8b
GRAPH_OLLAMA_VISION_MODEL=qwen2.5vl:7b
# GRAPH_OLLAMA_RAG_MODEL=llama3.2:3b


## ============================================================
## Qdrant
## ============================================================

QDRANT_HTTP_URL=http://qdrant:6333
QDRANT_SCHEME=http
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=hawki_docs
QDRANT_API_KEY=
QDRANT_TIMEOUT=30
QDRANT_RETRY_ATTEMPTS=3
QDRANT_TEXT_FALLBACK_TERMS=3

# Python API startup checks
STARTUP_CHECKS_ENABLED=false
STARTUP_CHECK_ATTEMPTS=3
STARTUP_CHECK_TIMEOUT_SECONDS=3
STARTUP_CHECK_BACKOFF_SECONDS=0.5


## ============================================================
## Neo4j
## ============================================================

NEO4J_HTTP_URL=http://hawki_rag_neo4j:7474
# NEO4J_BOLT_URL=bolt://hawki_rag_neo4j:7687
# NEO4J_PASSWORD is set in the required settings at the top of this file.
NEO4J_USER=neo4j
NEO4J_DATABASE=
# Driver-owned retry window for execute_read/execute_write managed transactions.
NEO4J_MAX_TRANSACTION_RETRY_TIME=30


## ============================================================
## RAG-Anything / LightRAG Graph
## ============================================================

GRAPH_ENGINE=raganything
RAG_WORKING_DIR=/app/rag_storage

GRAPH_DOC_MAX_CHUNKS=6
GRAPH_DOC_MAX_CHARS=6000
GRAPH_RESET_CACHE_PER_DOC=true
GRAPH_MIN_CHUNK_CHARS=80
GRAPH_MIN_DOC_CHARS=80
GRAPH_TEMPERATURE=0.0
GRAPH_STRIP_PIPES=true
GRAPH_DISABLE_GLEANING=false
GRAPH_PROMPT_MAX_EXAMPLES=1
GRAPH_PERF_LOG=0

KG_MAX_GLEANING=1
KG_LANGUAGE=English
KG_ENTITY_TYPES='["Person","Organization","Location","Event","Concept"]'

GRAPH_EMBED_JUNK_STRICT=true
GRAPH_EMBED_JUNK_DENYLIST=
GRAPH_EMBED_JUNK_ALLOWLIST=

MAX_ASYNC=2
MAX_PARALLEL_INSERT=2
OLLAMA_NUM_PREDICT=256
OLLAMA_NUM_GPU=1
OLLAMA_GPU_LAYERS=999


## ============================================================
## Reranking and Query
## ============================================================

RERANKER_PROVIDER=cohere
RERANKER_MODE=external
RERANKER_API_URL=http://hawki_rag_rerank/v1/rerank
RERANKER_MIX_MODE=true
JINA_API_KEY=
JINA_RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v1
QUERY_MODE=mix


## ============================================================
## Search Providers
## ============================================================

WEB_SEARCH_PROVIDER=tavily
BRAVE_SEARCH_API_KEY=
TAVILY_SEARCH_API_KEY=


## ============================================================
## MCP
## ============================================================

MCP_SERVER=hawki_rag
MCP_ENABLED=true
MCP_ROUTE_ENABLED=true
MCP_BASE_URL="${APP_URL}"
MCP_TIMEOUT=30
MCP_USE_FALLBACK=true
MCP_INGEST_ENABLED=true
MCP_TOOL_RAG_QUERY=true
MCP_TOOL_RAG_INGEST=true


## ============================================================
## Mail
## ============================================================

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


## ============================================================
## Frontend
## ============================================================

VITE_APP_NAME="${APP_NAME}"


