# Copy to .env.ollama and pass --env-file .env.ollama after --env-file .env.
# Include docker-compose.with-ollama.yml after the base file.
# For direct Ollama in .env, use RAG_BACKEND_DATASET_EMBEDDING_PROVIDER=ollama,
# the exact embedding model (for example bge-m3), and an ollama-only JSON
# RAG_BACKEND_QUERY_MODELS registry. Match the active datasets' model inventory.
# If adding LiteLLM as well, enable only the needed routes in its config.

OLLAMA_CHAT_TIMEOUT=240
OLLAMA_NUM_PREDICT=256
OLLAMA_KEEP_ALIVE=24h
GPU_MIN_FREE_MB=4096
# Space-delimited list pulled at startup. Keep the required models listed.
RAG_OLLAMA_MODELS=bge-m3 llama3.1:8b llama3.2:1b qwen2.5vl:7b
