## ============================================================
## Fragment: Ollama model serving
## ============================================================

# Activate by copying to .env.ollama next to .env (deploy.sh and every
# compose service pick it up automatically; see .env.example). Use when
# models are served by Ollama - the local addon
# (docker-compose.with-ollama.yml, optionally with GPU) or an external
# server. The core defaults (RAG_PROVIDER=ollama, ollama/-prefixed model
# names) already match; nothing else needs editing.

# Ollama API root the provider clients call; the code default host (ollama)
# does not match this stack's container name (hawki_ollama).
OLLAMA_API_URL=http://hawki_ollama:11434/api
# Chat/vision request timeout in seconds; the helper default (120) is too
# short for large local models.
OLLAMA_CHAT_TIMEOUT=240
# Ollama duration string for how long models stay loaded after a request
# (e.g. 24h, 5m, -1 = forever); unset means the server unloads quickly.
OLLAMA_KEEP_ALIVE=24h
# Space-separated models the ollama-entrypoint.sh pulls at container start -
# trim for CPU-only hosts (the vision model is large).
HAWKI_RAG_OLLAMA_MODELS=bge-m3 llama3.1:8b llama3.2:1b qwen2.5vl:7b
