# Copy to .env.litellm and pass --env-file .env.litellm after --env-file .env.
# Include docker-compose.with-litellm.yml after the base file.
# The addon sets LITELLM_API_URL=http://litellm:4000/v1 for RAWKI clients.
# In the base .env, supply a separately provisioned LITELLM_API_KEY starting
# with sk-. This stateless gateway uses it as its master key and API bearer key.
# Pin a tested tag or digest for the deployment and set real upstream routes.
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable
LITELLM_PORT=4000

# Required for the default OpenAI-backed example routes. Use real model IDs
# approved for this deployment. Add credentials for other configured routes here.
OPENAI_API_KEY=
LITELLM_OPENAI_CHAT_MODEL=
LITELLM_OPENAI_EMBED_MODEL=
LITELLM_OPENAI_VISION_MODEL=
# ANTHROPIC_API_KEY=
