# Makefile.local - helper targets for running the HAWKI stack directly on macOS without Docker.
# Deprecated/advanced: prefer Docker-based Make targets; keep this for power users with local installs.
#
# Assumptions:
#   • You have installed the required services natively (Ollama, Qdrant, Neo4j, PHP, Node.js, Python).
#   • Homebrew services are used for Qdrant and Neo4j (override variables below if you manage them differently).
#   • A Python virtualenv is optional; adjust PIP/PYTHON/UVICORN variables as needed for your environment.
#
# Usage:
#   make -f Makefile.local ensure-models       # pull Ollama models locally
#   make -f Makefile.local start-qdrant         # start Qdrant via Homebrew services
#   make -f Makefile.local start-python         # run the FastAPI bridge (blocks terminal)
#   make -f Makefile.local start-laravel        # start the Laravel app (blocks terminal)
#   make -f Makefile.local start-all            # sequentially run ensure/start helpers
#
# Stop commands mirror the start targets and simply proxy to brew services or kill processes.

SHELL := /bin/bash

# --- Tooling commands (override via environment when invoking make) ---
PYTHON      ?= python3
PIP         ?= pip3
UVICORN     ?= uvicorn
NODE        ?= npm
COMPOSER    ?= composer
ARTISAN     ?= php artisan
OLLAMA      ?= ollama

# Homebrew service names (override if you manage them differently)
BREW_QDRANT ?= qdrant
BREW_NEO4J  ?= neo4j

# Service URLs used by health checks
QDRANT_HTTP ?= http://127.0.0.1:6333
OLLAMA_HTTP ?= http://127.0.0.1:11434
FASTAPI_URL ?= http://127.0.0.1:8009
LARAVEL_URL ?= http://127.0.0.1:8002

.PHONY: ensure-models install-python install-node install-php start-qdrant stop-qdrant start-neo4j stop-neo4j start-python stop-python start-laravel stop-laravel start-all stop-all health

ensure-models:
	@command -v $(OLLAMA) >/dev/null || { echo "Ollama CLI not found (https://ollama.com/download)"; exit 1; }
	@echo "Pulling Ollama embedding model (bge-m3)..."
	@$(OLLAMA) pull bge-m3
	@echo "Pulling Ollama chat model (llama3:8b)..."
	@$(OLLAMA) pull llama3:8b

install-python:
	@echo "Installing Python dependencies..."
	@$(PIP) install -r python_rag/requirements.txt

install-node:
	@echo "Installing Node packages..."
	@$(NODE) install
	@$(NODE) run build

install-php:
	@echo "Installing Composer dependencies..."
	@$(COMPOSER) install

start-qdrant:
	@command -v brew >/dev/null || { echo "Homebrew not available; start Qdrant manually."; exit 1; }
	@echo "Starting Qdrant via brew services..."
	@brew services start $(BREW_QDRANT)

stop-qdrant:
	@command -v brew >/dev/null || { echo "Homebrew not available; stop Qdrant manually."; exit 1; }
	@echo "Stopping Qdrant via brew services..."
	@brew services stop $(BREW_QDRANT)

start-neo4j:
	@command -v brew >/dev/null || { echo "Homebrew not available; start Neo4j manually."; exit 1; }
	@echo "Starting Neo4j via brew services..."
	@brew services start $(BREW_NEO4J)

stop-neo4j:
	@command -v brew >/dev/null || { echo "Homebrew not available; stop Neo4j manually."; exit 1; }
	@echo "Stopping Neo4j via brew services..."
	@brew services stop $(BREW_NEO4J)

start-python:
	@echo "Starting FastAPI bridge (Ctrl+C to stop)..."
	@cd python_rag && $(UVICORN) app.main:app --host 0.0.0.0 --port 8009

stop-python:
	@echo "Stopping FastAPI bridge requires Ctrl+C in the terminal where it is running."

start-laravel:
	@echo "Starting Laravel app (Ctrl+C to stop)..."
	@$(ARTISAN) serve --host=127.0.0.1 --port=8002

stop-laravel:
	@echo "Stopping Laravel app requires Ctrl+C in the terminal where it is running."

start-all: ensure-models start-qdrant start-neo4j
	@echo "Remember to launch Ollama separately if not already running: 'ollama serve'"
	@echo "Now start the application servers in separate shells:"
	@echo "  make -f Makefile.local start-python"
	@echo "  make -f Makefile.local start-laravel"

stop-all: stop-qdrant stop-neo4j
	@echo "Stop the FastAPI and Laravel servers with Ctrl+C in their respective terminals."

health:
	@echo "Checking Qdrant..." && curl -fsS $(QDRANT_HTTP)/readyz && echo " OK" || (echo " FAIL" && exit 1)
	@echo "Checking Ollama..." && curl -fsS $(OLLAMA_HTTP)/api/tags >/dev/null && echo " OK" || (echo " FAIL" && exit 1)
	@echo "Checking FastAPI bridge..." && curl -fsS $(FASTAPI_URL)/health && echo " OK" || (echo " FAIL" && exit 1)
	@echo "Checking Laravel app..." && curl -fsS $(LARAVEL_URL) >/dev/null && echo " OK" || (echo " WARN" && exit 0)
