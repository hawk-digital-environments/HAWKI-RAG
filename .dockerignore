# Reduce Docker build context size and speed up builds

# VCS and local artifacts
.git
.gitignore
.DS_Store
node_modules
vendor

# Laravel build outputs and caches
gateway/public/build
gateway/storage/logs
gateway/storage/framework/cache
gateway/storage/framework/sessions
gateway/storage/framework/views

# Large local data (mounted at runtime)
gateway/storage/app/private/crawled-data
../hawki-data/crawled-data

# Environment and local config (provided at runtime)
.env
*.local

# Docker and ops
*.Dockerfile
docker/pythonBridge.Dockerfile
docker/*.log
ops/local-reranker/__pycache__
