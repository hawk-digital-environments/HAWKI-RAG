# Keep Docker build contexts small and reproducible.

# VCS and local metadata
.git/
.gitignore
.dockerignore
.DS_Store

# Dependencies installed inside images
node_modules/
vendor/

# Environment, secrets, and local overrides
.env
.env.*
auth.json
docker-compose.override.yml
*.local

# Laravel runtime and build outputs
public/build/
public/hot
public/storage/
storage/**

# Local RAG/runtime data and generated artifacts
rag_storage/
python_rag/public/
python_rag/rag_storage/
python_rag/rabbit_worker/
python_rag/rabbitmq/
python_rag/workers/
../hawki-data/crawled-data/

# Python caches and test artifacts
**/__pycache__/
**/.venv/
**/.venv*/
**/tests/
**/build/
**/dist/
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
.tox/
.venv/
.venv*/

# Documentation and local tooling not needed in runtime images
_documentation/
_documentation.build/
resources/js/crawler/
.agents/
.codex/
.github/
.idea/
.vscode/
bruno/
docs/

# Logs and temporary files
*.log
npm-debug.log
yarn-error.log
