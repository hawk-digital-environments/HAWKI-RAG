## -------------------------------
## Application Core
## -------------------------------
##
## Basic Laravel application identity, runtime mode, and URL settings.
## These values affect local development behavior, debugging, and URL generation.

APP_NAME="HAWKI RAG"
APP_ENV=local
APP_KEY=your_app_key_here
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

## -------------------------------
## Localization
## -------------------------------
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

## -------------------------------
## Maintenance Mode
## -------------------------------
## Controls where maintenance mode state is stored.

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file

## -------------------------------
## PHP + Logging
## -------------------------------
##
## Development web server worker count and Laravel logging configuration.
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -------------------------------
# Database Server
# -------------------------------

DB_CONNECTION=mysql
#
## MySQL / MariaDB (docker-compose defaults)
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=rag_db
DB_USERNAME=rag_user
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_root
PHPMYADMIN_PORT=8005

# -------------------------------
# Session Configuration
# -------------------------------
# Controls how user sessions are stored and how long they remain valid.
# For local development the file driver is simplest. For production, consider
# database or Redis-backed sessions for multi-instance deployments.
#
#  - SESSION_DRIVER:            Session backend ("file", "database", "redis", ...)
#  - SESSION_LIFETIME:          Session lifetime in minutes
#  - SESSION_ENCRYPT:           Encrypt session payloads at rest
#  - SESSION_PATH:              Cookie path scope
#  - SESSION_DOMAIN:            Cookie domain (null = current host)
#  - SESSION_EXPIRE_ON_CLOSE:   Expire cookie when browser closes
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE="true"

# -------------------------------
# App Runtime Services
# -------------------------------
# Core framework service drivers for broadcast events, filesystem storage,
# background queues, and cache behavior.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=

# -------------------------------
# Memcached (Optional)
# -------------------------------
# Host configuration if Memcached is used as a cache backend.
MEMCACHED_HOST=127.0.0.1

# -------------------------------
# Redis (Optional)
# -------------------------------
# Uncomment and configure these values if Redis is enabled as cache/session/queue backend.
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=change_me

# -------------------------------
# RabbitMQ
# -------------------------------
# RabbitMQ credentials and vhost for messaging/queue integrations.
# RABBITMQ_USER=change_me
# RABBITMQ_PASSWORD=change_me
# RABBITMQ_VHOST=/

# -------------------------------
# Mail Mailer
# -------------------------------
# Outbound email transport settings. Default "log" mailer writes emails to logs
# for local development instead of sending them.
#  - MAIL_MAILER:       Transport driver ("smtp", "sendmail", "log", ...)
#  - MAIL_HOST/PORT:    SMTP server host/port
#  - MAIL_USERNAME/PASSWORD: SMTP credentials
#  - MAIL_FROM_*:       Default sender identity
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -------------------------------
# AWS Configuration
# -------------------------------
#
# AWS credentials and S3-compatible storage settings used when integrating
# with Amazon S3 or compatible object storage providers.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# -------------------------------
# Frontend / Vite
# -------------------------------
#
# Frontend build-time app name exposed to Vite-powered UI components.
VITE_APP_NAME="${APP_NAME}"

# -------------------------------
# Ollama Configuration
# -------------------------------
# Base URL for the Ollama API used for local/server model inference.
# OLLAMA_API_URL: URL for the Ollama API
# for local >
# OLLAMA_API_URL=http://localhost:11434/api
# for server >
OLLAMA_API_URL=http://hawki_ollama_gpu:11434/api

# -------------------------------
# NEW CHNAGES GRAPH
# RAG-Anything Multimodal Knowledge Graph
# -------------------------------
#
# Official RAG-Anything based KG ingestion (used by the Neo4j graph ingest flow).
# The app now uses RAG-Anything content insertion + internal KG generation instead
# of a direct LightRAG extraction wrapper in our code.
#
# Minimal working set (CPU or GPU):
#  - GRAPH_OLLAMA_RAG_MODEL  : graph extraction/chat model
#  - OLLAMA_EMBED_MODEL      : embedding model used by RAG-Anything internals
#  - OLLAMA_CHAT_TIMEOUT     : timeout for model responses during KG extraction
#  - RAG_WORKING_DIR         : persistent KG/KV working directory inside container
#  - NEO4J_*                 : Neo4j connection used for graph export/upsert
#
# GPU note (6 GB cards like GTX 1660 Ti):
#  - `llama3.1:8b` is more robust for structured extraction but may be slower.
#  - If memory/latency is too high, try `llama3.2:3b`.
#
# Local bind-mount permissions (prevents root-owned kv_store*.json on host)
# Used by docker-compose `user:` for Python graph services.
LOCAL_UID=1000
LOCAL_GID=1000

# RAG-Anything / LightRAG working directory (inside graph containers)
RAG_WORKING_DIR=/app/rag_storage

# Extraction trimming (keeps graph runs stable on CPU and smaller GPUs)
GRAPH_DOC_MAX_CHUNKS=2
GRAPH_DOC_MAX_CHARS=800
GRAPH_MIN_CHUNK_CHARS=80
GRAPH_MIN_DOC_CHARS=80
GRAPH_TEMPERATURE=0.0
GRAPH_STRIP_PIPES=true
GRAPH_DISABLE_GLEANING=false
GRAPH_PROMPT_MAX_EXAMPLES=1
KG_MAX_GLEANING=1
KG_LANGUAGE=English
KG_ENTITY_TYPES='["Person","Organization","Location","Event","Concept"]'
GRAPH_PERF_LOG=0

# Graph embedding junk filter (RAG-Anything/LightRAG graph path only)
# - Filters obvious parser residue / boilerplate labels before Ollama embeddings.
# - `GRAPH_EMBED_JUNK_STRICT=true` adds a stricter built-in filter for labels like
#   "Main Content", "Stage", and common form placeholder patterns.
# - Allowlist overrides denylist and built-in strict filtering.
# - Pattern list syntax (semicolon-separated recommended):
#     exact:main content; exact:stage; contains:skip to; re:^str\\.,\\s*nr\\.
GRAPH_EMBED_JUNK_STRICT=true
GRAPH_EMBED_JUNK_DENYLIST=
GRAPH_EMBED_JUNK_ALLOWLIST=

# Graph model/runtime (shared variable names preserved)
GRAPH_OLLAMA_RAG_MODEL=llama3.1:8b
# GRAPH_OLLAMA_RAG_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_RAG_MODEL=llama3.1:8b
OLLAMA_CHAT_TIMEOUT=240
# Keep ingest running when Ollama embeddings hits the NaN serialization bug
OLLAMA_EMBED_NAN_ZERO_FALLBACK=true

# Optional advanced throughput controls (usually keep defaults)
MAX_ASYNC=2
MAX_PARALLEL_INSERT=2
OLLAMA_NUM_PREDICT=256
OLLAMA_NUM_GPU=1
OLLAMA_GPU_LAYERS=999

# Neo4j graph export target (RAG-Anything KG -> Neo4j mirror)
NEO4J_HTTP_URL=http://hawki_rag_neo4j:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
# Optional explicit bolt URI (otherwise derived from NEO4J_HTTP_URL)
# NEO4J_BOLT_URL=bolt://hawki_rag_neo4j:7687
# Optional target database name (Neo4j Community usually falls back to `neo4j`)
# Can also be overridden per ingest run from the UI "Neo4j collection / DB name" field.
NEO4J_DATABASE=

# -------------------------------
# Optional external APIs
# -------------------------------
#
# Tokens for optional third-party services used for crawling or LLM access.


# CRAWL4AI_API_TOKEN=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# -------------------------------
# File Converter
# -------------------------------
#
# Token and endpoint for the external/local file conversion/extraction service.
# ADD YOUR FILE CONVERTER TOKEN HERE:
FILE_CONVERTER_TOKEN=file-converter-key
FILE_CONVERTER_URL=http://127.0.0.1:8001/extract

# -------------------------------
# MCP + HAWKI RAG Tooling
# -------------------------------
#
# Internal integration paths and service URLs used by Hawki RAG tooling,
# bridge services, ingest status files, model defaults, and vector storage.
MCP_SERVER=hawki_rag
HAWKI_RAG_BRIDGE_URL=http://hawki_rag_bridge:8000
HAWKI_RAG_SHARED_ROOT=/var/www/storage/app/public
HAWKI_RAG_INGEST_STATUS_PATH=/var/www/storage/logs/ingest_status.json
HAWKI_RAG_INGEST_LOG_PATH=/var/www/storage/logs/ingest_progress_full.log
HAWKI_RAG_INGEST_LOG_CACHE_PATH=/var/www/storage/logs/ingest_progress_cache.log
HAWKI_RAG_INGEST_STATUS_PATH_NEO4J=/var/www/storage/logs/ingest_status_neo4j.json
HAWKI_RAG_INGEST_LOG_PATH_NEO4J=/var/www/storage/logs/ingest_progress_neo4j_full.log
HAWKI_RAG_INGEST_LOG_CACHE_PATH_NEO4J=/var/www/storage/logs/ingest_progress_neo4j_cache.log
HAWKI_RAG_API_URL=http://raganything_api_gpu:8003
QDRANT_HTTP_URL=http://qdrant:6333




# -------------------------------
# Search Provider
# -------------------------------
#
# Web search provider selection and API keys for enabled providers.
WEB_SEARCH_PROVIDER=tavily
BRAVE_SEARCH_API_KEY=
TAVILY_SEARCH_API_KEY=
