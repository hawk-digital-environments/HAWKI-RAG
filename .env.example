APP_NAME=Laravel
APP_ENV=local
APP_KEY=your_app_key_here
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -------------------------------
# Database Server
# -------------------------------
#
# RAG uses a database to store embeddings, scraped content, and search data. For this a 
# relational SQL database like MariaDB (MySQL) or Postgres should be used in production. 
# For local development SQLite provides a zero-config default solution (but note that 
# SQLite is single-user only and stores all data in a single file).
#
# For large embedding datasets, MySQL/MariaDB with compression provides significant 
# storage savings. PostgreSQL is also excellent for vector operations.
#
# IMPORTANT: When using a database other than SQLite set DB_DATABASE to a sensible value.
# Because the default value in config/database.php is "laravel" which is less clear and
# could at least in theory already be in use by other applications.
#
#  - DB_CONNECTION: Database server type: "mysql", "sqlite", "mariadb", "pgsql", "sqlsrv", "rag_mysql" (see config/database.php)
#  - DB_HOST:       Database server host name
#  - DB_PORT:       Database server port number
#  - DB_DATABASE:   Database name
#  - DB_USERNAME:   Username to access the database server
#  - DB_PASSWORD:   Password to access the database server

# DB_CONNECTION=rag_mysql
#
# ## MySQL / MariaDB
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=rag_app
# DB_USERNAME=
# DB_PASSWORD=

# -------------------------------
# Neo4j (graph store)
# -------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# ===========================
# Session Configuration
# ===========================

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE="true"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_DRIVER=file
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -------------------------------
# GWDG Configuration
# -------------------------------
#
# GWDG_API_KEY: API Key for the GWDG API
# GWDG_API_URL: URL for the GWDG API

# GWDG_API_KEY=your_api_key_here
# GWDG_API_URL=your_api_url_here

# -------------------------------
# RabbitMQ
# -------------------------------
RABBITMQ_USER=change_me
RABBITMQ_PASSWORD=change_me
RABBITMQ_VHOST=/

# -------------------------------
# Graph Extraction (LightRAG)
# -------------------------------
# Disable gleaning (iterative refinement) for faster graph extraction.
GRAPH_DISABLE_GLEANING=false
GRAPH_PROMPT_MAX_EXAMPLES=1
GRAPH_DOC_MAX_CHUNKS=3
GRAPH_DOC_MAX_CHARS=2000
GRAPH_TEMPERATURE=0.0
GRAPH_STRIP_PIPES=true
KG_MAX_GLEANING=1
KG_LANGUAGE=English
KG_ENTITY_TYPES='["Person","Organization","Location","Event","Concept"]'
GRAPH_PERF_LOG=0
GRAPH_OLLAMA_RAG_MODEL=llama3.2:3b
MAX_ASYNC=4
MAX_PARALLEL_INSERT=4

# -------------------------------
# Redis (if enabled)
# -------------------------------
REDIS_PASSWORD=change_me

# -------------------------------
# Optional external APIs
# -------------------------------
CRAWL4AI_API_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -------------------------------
# Ollama Configuration
# -------------------------------
#
# OLLAMA_API_URL: URL for the Ollama API
#for local > 
# OLLAMA_API_URL=http://localhost:11434/api
#for server >
OLLAMA_API_URL=http://hawki_ollama:11434/api

### File Converter Token
# ADD YOUR FILE CONVERTER TOKEN HERE:
FILE_CONVERTER_TOKEN=file-converter-key
FILE_CONVERTER_URL=http://127.0.0.1:8001/extract
### NEO4J 
NEO4J_HTTP_URL=http://hawki_rag_neo4j:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
# -------------------------------
# MCP + HAWKI RAG Tooling
# -------------------------------
MCP_SERVER=hawki_rag
HAWKI_RAG_BRIDGE_URL=http://hawki_rag_bridge:8000
HAWKI_RAG_SHARED_ROOT=/var/www/storage/app/public
HAWKI_RAG_INGEST_STATUS_PATH=/var/www/storage/logs/ingest_status.json
HAWKI_RAG_INGEST_LOG_PATH=/var/www/storage/logs/ingest_progress_full.log
HAWKI_RAG_INGEST_LOG_CACHE_PATH=/var/www/storage/logs/ingest_progress_cache.log
HAWKI_RAG_INGEST_STATUS_PATH_NEO4J=/var/www/storage/logs/ingest_status_neo4j.json
HAWKI_RAG_INGEST_LOG_PATH_NEO4J=/var/www/storage/logs/ingest_progress_neo4j_full.log
HAWKI_RAG_INGEST_LOG_CACHE_PATH_NEO4J=/var/www/storage/logs/ingest_progress_neo4j_cache.log
HAWKI_RAG_EMBED_MODELS=bge-m3
HAWKI_RAG_EMBED_MODEL=bge-m3
HAWKI_RAG_API_URL=http://raganything_api_gpu:8000
QDRANT_HTTP_URL=http://qdrant:6333
NEO4J_HTTP_URL=http://hawki_rag_neo4j:7474
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_TEXT_MODEL=llama3.2:3b
OLLAMA_RAG_MODEL=llama3.2:3b
GRAPH_OLLAMA_RAG_MODEL=llama3.2:3b

# Search provider
WEB_SEARCH_PROVIDER=tavily
BRAVE_SEARCH_API_KEY=
TAVILY_SEARCH_API_KEY=
