## ============================================================
## HAWKI Backend Persistence
## ============================================================
## Python owns only the `hawki_backend` PostgreSQL schema.
##
## Leave this block unset when Python persistence is not used.
##
## IMPORTANT:
## Production must use a dedicated least-privilege PostgreSQL role
## restricted to the `hawki_backend` schema.
##
## The dedicated runtime role is intentionally not provisioned by this branch.

HAWKI_BACKEND_DB_DSN=postgresql+psycopg://hawki_backend_app:change_me@postgres:5432/hawki_rag
HAWKI_BACKEND_DB_POOL_SIZE=5
HAWKI_BACKEND_DB_POOL_TIMEOUT_SECONDS=3
HAWKI_BACKEND_DB_POOL_RECYCLE_SECONDS=300
HAWKI_BACKEND_DB_CONNECT_TIMEOUT_SECONDS=3
HAWKI_BACKEND_DB_STATEMENT_TIMEOUT_MS=2000
# TEST ONLY.
# Destructive persistence integration tests run only when BOTH:
# - HAWKI_BACKEND_DB_TESTING=1
# - the database name ends with `_test`
# Never enable this against the application database.
# HAWKI_BACKEND_DB_TESTING=1

## ============================================================
## Docker Compose and Container Adapters
## ============================================================

# Compose reads this file once and injects it into every configured service.
HAWKI_RAG_COMPOSE_ENV_FILE=.env

# Host identity used for shared-volume ownership.
PUID=1000
PGID=1000
PIPELINE_SHARED_STORAGE_UID=${PUID}
PIPELINE_SHARED_STORAGE_GID=${PGID}

DOCKER_SERVICE_PROTOCOL=http
DOCKER_PROJECT_HOST=localhost:8080
DOCKER_PROJECT_PATH=/
DOCKER_PROJECT_PROTOCOL=http
VIRTUAL_HOST=${DOCKER_PROJECT_HOST}
VIRTUAL_PATH=${DOCKER_PROJECT_PATH}
VIRTUAL_DEST=/
NGINX_CLIENT_MAX_BODY_SIZE=128M

# Adapter names required by the PostgreSQL and Temporal images. Credentials
# reference the canonical DB_* values instead of duplicating their contents.
POSTGRES_DB=${DB_DATABASE}
POSTGRES_USER=${DB_USERNAME}
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_PWD=${DB_PASSWORD}
POSTGRES_SEEDS=postgres
DB=postgres12
BIND_ON_IP=0.0.0.0
DEFAULT_NAMESPACE=${TEMPORAL_NAMESPACE}
TZ=Europe/Berlin
TEMPORAL_CORS_ORIGINS=${TEMPORAL_UI_CORS_ORIGINS}

# Internal service addresses and PostgreSQL-backed monitor retention.
NEO4J_AUTH=${NEO4J_USER}/${NEO4J_PASSWORD}
NEO4J_URI=bolt://hawki_rag_neo4j:7687
HAWKI_RAG_MONITOR_RETENTION_DAYS=30
HAWKI_RAG_WORKER_CALLBACK_URL=http://hawki_backend/internal/pipeline/worker-events
HAWKI_RAG_TEMPORAL_SCRAPER_LOG_PATH=/shared/logs/scraper_worker.log
HAWKI_RAG_TEMPORAL_CONVERTER_LOG_PATH=/shared/logs/converter_worker.log
HAWKI_RAG_TEMPORAL_INDEXER_LOG_PATH=/shared/logs/indexer_worker.log

# Container image/runtime settings previously defaulted in Compose.
GPU_MIN_FREE_MB=4096
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable

## ============================================================
## HAWKI Backend Query Scope Registry
## ============================================================
## MIGRATION-TIME configuration only: a server-owned source of
## physical dataset scope for the Python query API. It is not read
## Python-owned dataset metadata in a later migration epoch.
##
## Leave this block unset when the Python query API is not used.
## If any HAWKI_BACKEND_QUERY_* variable is set, the configuration
## must be complete or the backend refuses to start.
##
## Each dataset requires qdrant_collection, embedding_provider and
## embedding_model. graph_enabled=true also requires neo4j_namespace.
## Every referenced provider requires a MODELS entry with chat_model
## and vision_model. These are server-owned; clients can never send
## a collection, namespace, provider or model.
##
## The examples below are placeholders and stay commented out.
## Epoch 7C: export actual scope/effective models with query:cutover-export;
## never activate with these placeholder IDs/models. See
## _documentation/Operations/python_query_cutover.md for the separate data,
## query-all policy, readiness and traffic-switch gates.
## Query reranker defaults to none in Python, but cutover must match the
## bridge's effective RERANKER_MODE (external in this example environment).

# HAWKI_BACKEND_QUERY_DATASETS='{"example-dataset":{"qdrant_collection":"hawki_example_dataset","neo4j_namespace":"hawki_example_dataset","embedding_provider":"ollama","embedding_model":"bge-m3","graph_enabled":true}}'
# HAWKI_BACKEND_QUERY_MODELS='{"ollama":{"chat_model":"llama3.1","vision_model":"llava"}}'
# HAWKI_BACKEND_QUERY_RERANKER=external
# HAWKI_BACKEND_QUERY_RERANK_TOP_N=20
# HAWKI_BACKEND_QUERY_RERANKER_MIX_MODE=true
# HAWKI_BACKEND_QUERY_RERANKER_MIX_WEIGHT=0.5

# Epoch 9 direct-text ownership; coordinated cutover only (no fallback).
TEXT_INGESTION_BACKEND=python
MANAGED_DOCUMENT_BACKEND=python
HAWKI_BACKEND_MANAGED_DOCUMENTS_ENABLED=false
# Epoch 11 URL ownership. Requires the reviewed CustomCrawler
# permanent-job runtime and passing its protected Chromium namespace/seccomp probe.
CRAWLER_INGESTION_BACKEND=python
# Dataset authority activates after query/text/managed/crawler; graph activates last.
DATASET_BACKEND=python
HAWKI_BACKEND_QUERY_DATASET_SOURCE=database
# Python URL execution; selector retained for historical migration validation.
# Python requires the existing Python crawler/workflow-control configuration and readiness.
# Rollback changes new starts only: keep Python ownership/callback routing available.
# Activation/rollback ordering: _documentation/Operations/epoch15a_cutover.md.
PIPELINE_EXECUTION_BACKEND=python
HAWKI_BACKEND_URL_INGESTION_ENABLED=true
# EXTERNAL_SCRAPER_URL above is canonical. CUSTOM_CRAWLER_URL is a legacy
# composition-time alias only when the canonical setting is absent.
# Optional server-owned directory for approved site profiles; empty rejects paths.
HAWKI_URL_SITE_PROFILE_ROOT=
HAWKI_BACKEND_TEXT_INGESTION_ENABLED=false
HAWKI_BACKEND_TEXT_INGESTION_SHARED_ROOT=/shared
HAWKI_BACKEND_TEXT_INGESTION_QDRANT_URL=http://qdrant:6333
HAWKI_BACKEND_TEXT_INGESTION_QDRANT_API_KEY=

# Epoch 15C staging/cutover overlays are documentation inputs, never auto-loaded:
# docker/env/epoch15c.staging.env.example
# docker/env/epoch15c.cutover.env.example
# Provision JWT/JWKS, signing mounts and exact grants before enabling authority.
# Full configuration contract: python_backend/.env.example.
# Ordered deployment/rollback: _documentation/Operations/epoch15c_cutover.md.

HAWKI_BACKEND_SERVICE_ONLY=true
HAWKI_BACKEND_LARAVEL_OFF=true
# HAWKI must return 204 only for authorized management requests, 401/403 otherwise.
HAWKI_RAG_UI_AUTHORIZATION_URL=
# Default external HAWKI policy; local overlay selects loopback-only local mode.
HAWKI_RAG_UI_ACCESS_MODE=hawki
HAWKI_RAG_UI_ORIGIN=http://localhost:8080
# Directory containing access.jwt, rotated by the issuer; mounted read-only.
# HAWKI_RAG_UI_CREDENTIAL_DIR=/absolute/path/to/ui-service
# Optional OAuth client-credentials flow; the gateway reads client.secret from
# the same mounted credential directory. The issuer, not RAWKI, signs JWTs.
HAWKI_RAG_UI_TOKEN_URL=
HAWKI_RAG_UI_CLIENT_ID=rag-management
HAWKI_RAG_UI_SCOPES=rag:query rag:ingest rag:datasets:manage

# External service JWT verifier. Values below are placeholders, not a usable issuer.
HAWKI_BACKEND_AUTH_ISSUER=https://issuer.example.invalid
HAWKI_BACKEND_AUTH_AUDIENCE=hawki-backend
HAWKI_BACKEND_AUTH_JWKS_URL=https://issuer.example.invalid/.well-known/jwks.json
HAWKI_BACKEND_AUTH_CLIENTS={"hawki-service":"service","rag-management":"service"}
HAWKI_BACKEND_AUTH_ALGORITHMS=RS256,ES256
HAWKI_BACKEND_READINESS_JWKS_KEY_ID=

# Enable only when deployment-managed custom converter defaults are intended.
HAWKI_BACKEND_CUSTOM_UPLOADS_ENABLED=false
