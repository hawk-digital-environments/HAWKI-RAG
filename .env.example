## ============================================================
## RAG-Anything / LightRAG Graph
## ============================================================

GRAPH_ENGINE=raganything
RAG_WORKING_DIR=/app/rag_storage

GRAPH_DOC_MAX_CHUNKS=6
GRAPH_DOC_MAX_CHARS=6000
GRAPH_RESET_CACHE_PER_DOC=true
GRAPH_MIN_CHUNK_CHARS=80
GRAPH_MIN_DOC_CHARS=80
GRAPH_TEMPERATURE=0.0
GRAPH_STRIP_PIPES=true
GRAPH_DISABLE_GLEANING=false
GRAPH_PROMPT_MAX_EXAMPLES=1
GRAPH_PERF_LOG=0

KG_MAX_GLEANING=1
KG_LANGUAGE=English
KG_ENTITY_TYPES='["Person","Organization","Location","Event","Concept"]'

GRAPH_EMBED_JUNK_STRICT=true
GRAPH_EMBED_JUNK_DENYLIST=
GRAPH_EMBED_JUNK_ALLOWLIST=

MAX_ASYNC=2
MAX_PARALLEL_INSERT=2
OLLAMA_NUM_PREDICT=256
OLLAMA_NUM_GPU=1
OLLAMA_GPU_LAYERS=999


## ============================================================
## Reranking and Query
## ============================================================

# A. Server defaults; explicit request reranker/mix fields take precedence.
# Internal RagSearcher requests external explicitly: mode=none is not a global disable.
# Local and SDK backends need RERANKER_MODE=external to be selected by default.
RERANKER_MODE=external
# cohere (alias: legacy_http) means the legacy HTTP backend, NOT hosted Cohere
# via the LiteLLM SDK.
RERANKER_PROVIDER=cohere
RERANKER_MIX_MODE=true
# Retrieval-signal weight when mixing (runtime default 0.5).
# RERANKER_MIX_WEIGHT=0.5

# B. Legacy HTTP reranker (external + cohere).
RERANKER_API_URL=http://hawki_rag_rerank/v1/rerank
# Optional bearer credential for the configured HTTP endpoint; empty by default.
# RERANKER_API_KEY=
# Standalone HTTP service model; also used by bridge-local inference.
# HAWKI_RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v1
# Standalone startup preload defaults to true; root Compose mounts hf_models.
# HAWKI_RERANKER_PRELOAD=true

# C. Local CrossEncoder: replace the provider above with local.
# RERANKER_PROVIDER=local
# Requires a bridge image built with --build-arg BRIDGE_LOCAL_RERANKER=true;
# the default production bridge image does not install local dependencies.
# Uses HAWKI_RERANKER_MODEL above; BGE option: BAAI/bge-reranker-v2-m3.
# Model loading is lazy; provision weights/cache. If both containers receive
# this variable, changing it also changes the standalone HTTP service model.

# D. LiteLLM Python SDK: replace the provider above with litellm.
# RERANKER_PROVIDER=litellm
# IxDLab uses the existing external gateway; no local proxy container required.
# The model must carry a rerank-capable provider prefix; unknown prefixes are
# rejected at startup instead of failing per query.
# RERANKER_MODEL=litellm_proxy/jina-rerank
# Optional single retryable-failure fallback: requires a litellm_proxy/ primary
# and another litellm_proxy/ alias on the same gateway. Unset/blank/none = off.
# IxDLab example (JLU mirror):
# RERANKER_FALLBACK_MODEL=litellm_proxy/jlu/jina-rerank
# Gateway failover is not independently verified. Disable application fallback
# when relying on verified gateway failover; neither covers gateway-wide outages.
# A trailing /v1 in the base is stripped automatically; LiteLLM appends its own path.
# LITELLM_PROXY_API_BASE=https://ai.ixdlab.hawk.de
# LITELLM_PROXY_API_KEY=
# For hosted SDK providers, use e.g. cohere/rerank-v3.5 with COHERE_API_KEY,
# or voyage/rerank-2.5 with VOYAGE_API_KEY. Do not put secrets in examples.
# These are independent of the chat/embedding LITELLM_API_URL/API_KEY pair.
# SDK model (and gateway base/key for litellm_proxy/) is required at startup,
# even when mode=none; LocalReranker weights remain lazy.

# E. Direct Jina: replace RERANKER_MODE above with jina; keep provider=cohere.
JINA_API_KEY=
# Omit the override to use the direct-Jina runtime default (not Mixedbread).
# JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual

# Legacy / currently unused by the application:
# QUERY_MODE=mix


