## ============================================================
## Application
## ============================================================

APP_NAME="HAWKI RAG"
APP_ENV=local
APP_KEY=your_app_key_here
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file


## ============================================================
## PHP, Logging, Runtime Drivers
## ============================================================

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file
CACHE_PREFIX=


## ============================================================
## Sessions
## ============================================================

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=true


## ============================================================
## MariaDB and Adminer
## ============================================================

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=rag_db
DB_USERNAME=rag_user
DB_PASSWORD=change_me

DB_ROOT_PASSWORD=change_me
DB_APP_USERNAME=rag_user
DB_APP_PASSWORD=change_me

ADMINER_PORT=8005
ADMINER_IMAGE=adminer:latest


## ============================================================
## Shared Storage and Pipeline Paths
## ============================================================

SHARED_STORAGE_ROOT=/app/shared
PIPELINE_SHARED_STORAGE_WEB_USER=www-data
HAWKI_RAG_PIPELINE_ROOT=/app/shared
HAWKI_RAG_PIPELINE_AUTOMATION=false
HAWKI_RAG_CONVERT_EXISTING_MODE=continue
HAWKI_RAG_INGEST_RESUME_MODE=resume
HAWKI_RAG_INGEST_RESUME_STATE_DIR=storage/app/private/ingest-state
HAWKI_RAG_CRAWLED_DATA_ROOT=/app/shared
DEFAULT_CRAWLED_ROOT=/app/shared


## ============================================================
## RabbitMQ Connection
## ============================================================

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F

RABBITMQ_HEARTBEAT=30
RABBITMQ_CONNECTION_TIMEOUT=30
RABBITMQ_READ_WRITE_TIMEOUT=30
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672


## ============================================================
## RabbitMQ Pipeline Event Bus
## ============================================================

RABBITMQ_EVENTS_EXCHANGE=pipeline.events
RABBITMQ_EVENTS_EXCHANGE_TYPE=direct

RABBITMQ_RETRY_EXCHANGE=pipeline.retry
RABBITMQ_RETRY_EXCHANGE_TYPE=direct
RABBITMQ_RETRY_DELAY_MS=5000

RABBITMQ_FAILED_EXCHANGE=pipeline.failures
RABBITMQ_FAILED_EXCHANGE_TYPE=direct
RABBITMQ_PIPELINE_FAILED_QUEUE=pipeline_failed_events


## ============================================================
## Laravel Pipeline Workers
## ============================================================

RABBITMQ_PREFETCH_COUNT=1
RABBITMQ_MAX_RETRIES=3
RABBITMQ_QUEUE_TYPE=quorum
RABBITMQ_CONSUMER_TAG=hawki-rag-laravel-worker
RABBITMQ_PIPELINE_SCRAPE_MONITOR_QUEUE=pipeline_scrape_monitor_events
RABBITMQ_PIPELINE_SCRAPE_MONITOR_CONSUMER_TAG=hawki-rag-scrape-monitor-events
PIPELINE_SCRAPE_MONITOR_MAX_ATTEMPTS=240
PIPELINE_SCRAPE_MONITOR_STATUS_READ_RETRIES=5

JOB_SCHEMA_VERSION=1
SERVICE_NAME=hawki-rag

# Set true to ingest RabbitMQ jobs with Neo4j graph extraction enabled.
RAG_INGEST_GRAPH=false
RAG_INGEST_BRIDGE_TIMEOUT=3600


## ============================================================
## Optional Crawler Producer
## ============================================================

RABBITMQ_EXCHANGE=jobs
RABBITMQ_MAIN_ROUTING_KEY=crawl
CRAWLER_PRODUCER_IMAGE=ghcr.io/example/hawki-crawler-producer:latest
CRAWLER_PRODUCER_COMMAND="python -m crawler_producer.main"


## ============================================================
## Scraper and File Converter
## ============================================================

CUSTOM_CRAWLER_URL=http://crawler:8000
CUSTOM_CRAWLER_API_KEY=
SCRAPE_STORAGE_PATH=/app/shared
SCRAPE_DEFAULT_MAX_PAGES=100
SCRAPE_DEFAULT_CONCURRENCY=4
SCRAPE_DEFAULT_MAX_RPM=60
SCRAPE_DEFAULT_SKIP_IMAGES=false
SCRAPE_DEFAULT_DISCOVERY_MODE=false

FILE_CONVERTER_TOKEN=file-converter-key
FILE_CONVERTER_URL=http://hawki-toolkit-file-converter-file-converter-1/extract
FILE_CONVERTER_HEALTH_URL=http://hawki-toolkit-file-converter-file-converter-1/health
FILE_CONVERTER_INFO_URL=http://hawki-toolkit-file-converter-file-converter-1/
FILE_CONVERTER_AUTH_HEADER=bearer
FILE_CONVERTER_SUPPORTED_EXTENSIONS=pdf,doc,docx,txt,md,markdown,html,htm,csv,xls,xlsx,ppt,pptx,odt,ods,odp,rtf,json,xml,yaml,yml,zip,png,jpg,jpeg,tif,tiff,webp,bmp,gif
FILE_CONVERTER_INTEGRATION_URL=http://127.0.0.1:8001/extract
FILE_CONVERTER_TIMEOUT=3600
FILE_CONVERTER_CONNECT_TIMEOUT=30
FILE_CONVERTER_RETRIES=3
FILE_CONVERTER_RETRY_DELAY_MS=1500


## ============================================================
## Python RAG Bridge and Ingest Runtime
## ============================================================

HAWKI_RAG_BRIDGE_URL=http://hawki_rag_bridge:8000
HAWKI_RAG_BASE_URL=http://hawki_rag_bridge:8000
HAWKI_RAG_API_URL=http://hawki_rag_bridge:8000

HAWKI_RAG_INGEST_STATUS_PATH=/var/www/html/storage/logs/ingest_status.json
HAWKI_RAG_INGEST_LOG_PATH=/var/www/html/storage/logs/ingest_progress_full.log
HAWKI_RAG_INGEST_LOG_CACHE_PATH=/var/www/html/storage/logs/ingest_progress_cache.log
HAWKI_RAG_INGEST_STATUS_PATH_NEO4J=/var/www/html/storage/logs/ingest_status_neo4j.json
HAWKI_RAG_INGEST_LOG_PATH_NEO4J=/var/www/html/storage/logs/ingest_progress_neo4j_full.log
HAWKI_RAG_INGEST_LOG_CACHE_PATH_NEO4J=/var/www/html/storage/logs/ingest_progress_neo4j_cache.log

RAG_DEFAULT_PROVIDER=ollama
INGEST_BATCH_SIZE=64
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=250
QDRANT_DISTANCE=Cosine


## ============================================================
## Ollama and RAG Models
## ============================================================

OLLAMA_API_URL=http://hawki_ollama:11434/api
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_RAG_MODEL=llama3.1:8b
OLLAMA_CHAT_TIMEOUT=240
OLLAMA_EMBED_NAN_ZERO_FALLBACK=true

GRAPH_OLLAMA_RAG_MODEL=llama3.1:8b
# GRAPH_OLLAMA_RAG_MODEL=llama3.2:3b


## ============================================================
## Qdrant
## ============================================================

QDRANT_HTTP_URL=http://qdrant:6333
QDRANT_SCHEME=http
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=hawki_docs
QDRANT_API_KEY=
QDRANT_TIMEOUT=30
QDRANT_RETRY_ATTEMPTS=3
QDRANT_TEXT_FALLBACK_TERMS=3

# Python API startup checks
STARTUP_CHECKS_ENABLED=true
STARTUP_CHECK_ATTEMPTS=3
STARTUP_CHECK_TIMEOUT_SECONDS=3
STARTUP_CHECK_BACKOFF_SECONDS=0.5


## ============================================================
## Neo4j
## ============================================================

NEO4J_HTTP_URL=http://hawki_rag_neo4j:7474
# NEO4J_BOLT_URL=bolt://hawki_rag_neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
NEO4J_DATABASE=
NEO4J_RETRY_ATTEMPTS=3


## ============================================================
## RAG-Anything / LightRAG Graph
## ============================================================

GRAPH_ENGINE=raganything
RAG_WORKING_DIR=/app/rag_storage

LOCAL_UID=1000
LOCAL_GID=1000

GRAPH_DOC_MAX_CHUNKS=6
GRAPH_DOC_MAX_CHARS=6000
GRAPH_RESET_CACHE_PER_DOC=true
GRAPH_MIN_CHUNK_CHARS=80
GRAPH_MIN_DOC_CHARS=80
GRAPH_TEMPERATURE=0.0
GRAPH_DISABLE_GLEANING=false
GRAPH_PROMPT_MAX_EXAMPLES=1
GRAPH_PERF_LOG=0

KG_MAX_GLEANING=1
KG_LANGUAGE=English
KG_ENTITY_TYPES='["Person","Organization","Location","Event","Concept"]'

GRAPH_EMBED_JUNK_STRICT=true
GRAPH_EMBED_JUNK_DENYLIST=
GRAPH_EMBED_JUNK_ALLOWLIST=

MAX_ASYNC=2
MAX_PARALLEL_INSERT=2
OLLAMA_NUM_PREDICT=256
OLLAMA_NUM_GPU=1
OLLAMA_GPU_LAYERS=999


## ============================================================
## Reranking and Query
## ============================================================

RERANKER_PROVIDER=cohere
RERANKER_MODE=external
RERANKER_API_URL=http://hawki_rag_rerank:8000/v1/rerank
RERANKER_MIX_MODE=true
JINA_API_KEY=
JINA_RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v1
QUERY_MODE=mix


## ============================================================
## Search Providers
## ============================================================

WEB_SEARCH_PROVIDER=tavily
BRAVE_SEARCH_API_KEY=
TAVILY_SEARCH_API_KEY=


## ============================================================
## MCP
## ============================================================

MCP_SERVER=hawki_rag
MCP_ENABLED=true
MCP_ROUTE_ENABLED=true
MCP_BASE_URL="${APP_URL}"
MCP_TIMEOUT=30
MCP_USE_FALLBACK=true
MCP_INGEST_ENABLED=true
MCP_TOOL_RAG_QUERY=true
MCP_TOOL_RAG_INGEST=true


## ============================================================
## Mail
## ============================================================

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


## ============================================================
## Frontend
## ============================================================

VITE_APP_NAME="${APP_NAME}"


## ============================================================
## Optional External APIs and Storage
## ============================================================

