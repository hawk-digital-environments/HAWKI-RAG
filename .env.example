## ============================================================
## Python RAG Bridge and Ingest Runtime
## ============================================================

HAWKI_RAG_BRIDGE_URL=http://hawki_rag_bridge
HAWKI_RAG_QUERY_TIMEOUT=300
HAWKI_RAG_HEALTH_GATE_ENABLED=true
HAWKI_RAG_HEALTH_GATE_TIMEOUT=3
HAWKI_RAG_HEALTH_GATE_REQUIRED=retrieval,graph,pipeline

# Single-user deployments query every current and future active dataset by
# default. Set false to require explicit per-dataset grants.
HAWKI_RAG_QUERY_ALL_DATASETS_BY_DEFAULT=true
SANCTUM_ROUTES=false
SANCTUM_EXPIRATION=null
SANCTUM_TOKEN_PREFIX=hawki_rag_
HAWKI_RAG_CORS_ALLOWED_ORIGINS=

# The single RAG runtime provider, stated plainly: ollama (local addon) or
# litellm (gateway). The base composition assumes an EXTERNAL LiteLLM
# gateway; a self-hosted proxy container is the with_litellm addon below.
# No default — missing configuration fails loud instead of silently
# picking a provider.
RAG_PROVIDER=litellm
RAG_GENERATE_ANSWER=true
INGEST_BATCH_SIZE=64
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=250
QDRANT_DISTANCE=Cosine

# Base chat/embedding gateway, separate from reranking's LITELLM_PROXY_*.
# The base setup assumes your external gateway (IxDLab example below);
# for the self-hosted proxy addon use http://litellm:4000/v1 instead.
# Upstream provider keys remain deployment secrets, never returned by Settings.
LITELLM_API_URL=https://ai.ixdlab.hawk.de/v1
LITELLM_API_KEY=
# Graph-only ingestion has no vector response from which to discover a model's
# dimension. Canonical model names are the keys (BAAI/bge-m3=1024,
# ollama/bge-m3=1024); keep this map synchronized with the embedding models
# you configure.
GRAPH_EMBEDDING_DIMENSIONS=BAAI/bge-m3=1024,ollama/bge-m3=1024
# Legacy / currently unused by the application:
# LITELLM_CHAT_TIMEOUT=240
# LITELLM_EMBED_TIMEOUT=60
# Current chat/embedding helpers read OLLAMA_CHAT_TIMEOUT/OLLAMA_EMBED_TIMEOUT.


## ============================================================
## RAG Models (canonical; prefix routes, bare names hit the gateway)
## ============================================================

# One set of keys for every backend: a routing prefix (ollama/...,
# ollama_chat/..., openai/..., anthropic/..., gemini/...) sends the request
# to that provider; a BARE name is a gateway alias passed through
# unchanged — use names your gateway advertises on /v1/models. Allowlist
# plurals feed the Settings UI and the gateway's route menu.
# Gateway-only stacks (no Ollama addon) need gateway aliases for all three.
EMBED_MODEL=BAAI/bge-m3
# IxDLab currently advertises no chat/vision aliases; either fill these
# with aliases your gateway lists, or keep the ollama_chat/ values and run
# the Ollama addon (chat/vision locally, embeddings via the gateway).
#CHAT_MODEL=
#VISION_MODEL=
# Local-only alternative (requires the Ollama addon):
#EMBED_MODEL=ollama/bge-m3
#CHAT_MODEL=ollama_chat/llama3.1:8b
#VISION_MODEL=ollama_chat/qwen2.5vl:7b
# Allowlists cover the default mixed mode (gateway embeddings + local chat/vision).
EMBED_MODELS=BAAI/bge-m3,ollama/bge-m3
CHAT_MODELS=ollama_chat/llama3.1:8b
VISION_MODELS=ollama_chat/qwen2.5vl:7b
# Optional graph-extraction override; defaults to CHAT_MODEL.
#GRAPH_RAG_MODEL=

## ============================================================
## Compose Addon: local Ollama server (compose/with_ollama.yml)
## ============================================================

# Included by up-core targets by default (WITH_OLLAMA=1); a gateway-only
# stack uses `make up-core WITH_OLLAMA=0`. To run everything locally,
# apply the deltas in .env.example.ollama (RAG_PROVIDER=ollama plus
# ollama-prefixed models). Mixed setups work too: ollama_chat/-prefixed
# chat/vision models hit this server while bare embeddings hit the gateway.
OLLAMA_API_URL=http://hawki_ollama:11434/api
OLLAMA_CHAT_TIMEOUT=240
OLLAMA_EMBED_NAN_ZERO_FALLBACK=true
# Ollama duration string; -1 keeps models resident forever. Applied both as
# the Ollama server default (compose/with_ollama.yml) and per request from
# the provider clients, so loaded models stay loaded between queries.
OLLAMA_KEEP_ALIVE=24h

## ============================================================
## Compose Addon: local LiteLLM gateway (compose/with_litellm.yml)
## ============================================================

# Self-hosted proxy alternative to the external gateway above. Start with
# `make up-gateway`, point LITELLM_API_URL at http://litellm:4000/v1, and
# keep RAG_PROVIDER=litellm with the model aliases you want routed through
# the proxy. Routes render at container startup from the canonical model
# keys (EMBED/CHAT/VISION_MODEL plus the plural allowlists): one
# passthrough route per allowlisted model, named by its full canonical
# string. Hosted routes need the standard credentials below; leave them
# empty to keep the routes unavailable (calls fail closed).
# Image for the addon container:
# LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable
# Optional local proxy host port only; not an SDK/gateway setting.
# LITELLM_PORT=4000
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
# Optional standard endpoints when routing hosted providers through a
# corporate proxy:
#OPENAI_API_BASE=https://api.openai.com/v1
#ANTHROPIC_API_BASE=https://api.anthropic.com

## ============================================================
## Compose Addon: Temporal workflow UI (compose/with_temporal_ui.yml)
## ============================================================

# Start with `make up-monitor-workflows-tool` (or the compose -f line in
# compose/README.md). Host-side binding only; the container always
# listens internally on 8080.
TEMPORAL_UI_HOST_BIND=127.0.0.1
TEMPORAL_UI_HOST_PORT=8081

## ============================================================
## Model Warmup (Temporal workflow: loads models at startup and daily)
## ============================================================

# The warmup follows RAG_PROVIDER (see "RAG Models" and config/config.php):
# "ollama" or "litellm". Model names come from EMBED_MODEL / CHAT_MODEL /
# VISION_MODEL, so switching providers keeps the warmup working without
# code changes.
#MODEL_WARMUP_ENABLED=true
#MODEL_WARMUP_SCHEDULE_CRON="0 6 * * *"
#MODEL_WARMUP_SCHEDULE_TZ=Europe/Berlin
#MODEL_WARMUP_QUERY="Reply with OK."
#MODEL_WARMUP_INCLUDE_VISION=true
# Pin the warmup query to one collection instead of auto-detecting the
# first existing Qdrant collection:
#MODEL_WARMUP_QDRANT_COLLECTION=hawki_assistant_1
#MODEL_WARMUP_DATASET_ID=model-warmup


