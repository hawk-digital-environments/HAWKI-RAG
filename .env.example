## ============================================================
## Python runtime and shared deployment settings
## ============================================================


## Python logging
LOG_LEVEL=info


## ============================================================
## PostgreSQL and Temporal Persistence
## ============================================================

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hawki_rag
DB_USERNAME=rag_user
DB_PASSWORD=change_me


## ============================================================
## Shared Storage and Pipeline Paths
## ============================================================

SHARED_STORAGE_ROOT=/shared
RAG_PIPELINE_ROOT=/shared
RAG_CRAWLED_DATA_ROOT=/shared
DEFAULT_CRAWLED_ROOT=/shared
RAG_RAGANYTHING_LOG_PATH=/shared/logs/raganything_runtime.log


## ============================================================
## Temporal RAG Orchestration
## ============================================================

RAG_TEMPORAL_ENABLED=true
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
# Host-side binding only; the container always listens internally on 8080.
TEMPORAL_CLIENT_IDENTITY=hawki-rag-python
TEMPORAL_INGEST_WORKFLOW_TYPE=IngestSourceWorkflow
TEMPORAL_WORKFLOW_EXECUTION_TIMEOUT=172800
TEMPORAL_WORKFLOW_RUN_TIMEOUT=86400
TEMPORAL_WORKFLOW_TASK_TIMEOUT=30
TEMPORAL_RAG_WORKFLOW_TASK_QUEUE=rag-workflow-task-queue
TEMPORAL_RAG_SCRAPER_TASK_QUEUE=rag-scraper-task-queue
TEMPORAL_RAG_CONVERTER_TASK_QUEUE=rag-converter-task-queue
TEMPORAL_RAG_INGESTION_TASK_QUEUE=rag-ingestion-task-queue
TEMPORAL_RAG_INDEXER_TASK_QUEUE=rag-ingestion-task-queue
TEMPORAL_RAG_DAILY_CRON="0 2 * * *"
TEMPORAL_RAG_WEEKLY_CRON="0 2 * * 0"
TEMPORAL_RAG_MONTHLY_CRON="0 2 1 * *"
TEMPORAL_RAG_HTTP_TIMEOUT_SECONDS=1800
TEMPORAL_RAG_HTTP_RETRY_ATTEMPTS=3
TEMPORAL_RAG_EXTERNAL_POLL_INTERVAL_SECONDS=5
TEMPORAL_RAG_EXTERNAL_POLL_TIMEOUT_SECONDS=43200
# Required before starting activity workers; generate with: openssl rand -hex 32
RAG_WORKER_CALLBACK_SECRET=
RAG_WORKER_CALLBACK_MAX_AGE_SECONDS=300

RAG_TEMPORAL_SHARED_ROOT=/shared

# Set true to ingest source workflows with Neo4j graph extraction enabled.
RAG_INGEST_GRAPH=false

## ============================================================
## External Scraper and File Converter
## ============================================================

CUSTOM_CRAWLER_URL=http://crawl4ai-service
CUSTOM_CRAWLER_API_KEY=
CUSTOM_CRAWLER_TASK_UI_URL=http://crawl4ai-service
CUSTOM_CRAWLER_TASK_UI_PROFILES_PATH=/ui/api/profiles
CUSTOM_CRAWLER_TASK_UI_TASKS_PATH=/ui/api/tasks
# Set a reviewed permanent-job-v2 endpoint before enabling URL ingestion.
EXTERNAL_SCRAPER_URL=
EXTERNAL_SCRAPER_START_PATH=/crawl
EXTERNAL_SCRAPER_STATUS_PATH=/status/{job_id}
EXTERNAL_SCRAPER_TOKEN=
SCRAPE_STORAGE_PATH=/shared
SCRAPE_ALLOWED_LOCAL_ROOTS=/shared
SCRAPE_DEFAULT_MAX_PAGES=100
SCRAPE_DEFAULT_CONCURRENCY=4
SCRAPE_DEFAULT_MAX_RPM=60
SCRAPE_DEFAULT_SKIP_IMAGES=false
SCRAPE_DEFAULT_DISCOVERY_MODE=false

FILE_CONVERTER_TOKEN=file-converter-key
FILE_CONVERTER_URL=http://hawki-toolkit-file-converter-file-converter-1/extract
FILE_CONVERTER_INTEGRATION_URL=http://127.0.0.1:8001/extract
FILE_CONVERTER_BASE_URL=http://hawki-toolkit-file-converter-file-converter-1
FILE_CONVERTER_HEALTH_URL=http://hawki-toolkit-file-converter-file-converter-1/health
EXTERNAL_CONVERTER_URL=http://hawki-toolkit-file-converter-file-converter-1
EXTERNAL_CONVERTER_START_PATH=/extract
EXTERNAL_CONVERTER_STATUS_PATH=
CUSTOM_CONVERTER_STATUS_PATH=/jobs/{job_id}
EXTERNAL_CONVERTER_TOKEN=file-converter-key
FILE_CONVERTER_SUPPORTED_EXTENSIONS=
FILE_CONVERTER_RETRIES=3


## ============================================================
## Python ingestion and query runtime
## ============================================================


RAG_WORKFLOW_CONTROL_URL=http://rag_backend
RAG_WORKFLOW_CONTROL_ENABLED=true


# Direct Ollama is the default local runtime. The optional self-hosted gateway
# is available with --profile litellm. Configure models per provider and dataset.
RAG_GENERATE_ANSWER=true
INGEST_BATCH_SIZE=64
CHUNK_SIZE=1200
CHUNK_OVERLAP_SIZE=250
QDRANT_DISTANCE=Cosine

# Optional OpenAI-compatible LiteLLM gateway. Upstream provider keys remain
# deployment secrets.
LITELLM_API_URL=http://litellm:4000/v1
LITELLM_API_KEY=
LITELLM_CHAT_MODEL=hawki-ollama-chat
LITELLM_EMBED_MODEL=hawki-ollama-embedding
LITELLM_VISION_MODEL=hawki-ollama-vision
LITELLM_CHAT_ALIASES=hawki-ollama-chat,hawki-gpt-chat,hawki-claude-chat,hawki-chat
LITELLM_EMBED_ALIASES=hawki-ollama-embedding,hawki-openai-embedding,hawki-embedding
LITELLM_VISION_ALIASES=hawki-ollama-vision,hawki-gpt-vision,hawki-claude-vision,hawki-vision
# Graph-only ingestion has no vector response from which to discover a model's
# dimension. Keep custom LiteLLM aliases synchronized with this trusted map.
GRAPH_EMBEDDING_DIMENSIONS=hawki-ollama-embedding=1024,hawki-openai-embedding=1536,hawki-embedding=1024
LITELLM_CHAT_TIMEOUT=240
LITELLM_EMBED_TIMEOUT=60
LITELLM_PORT=4000

# Local Ollama routes (no upstream API key required).
LITELLM_OLLAMA_API_BASE=http://hawki_ollama:11434
LITELLM_OLLAMA_CHAT_MODEL=ollama_chat/llama3.1:8b
LITELLM_OLLAMA_EMBED_MODEL=ollama/bge-m3
LITELLM_OLLAMA_VISION_MODEL=ollama_chat/qwen2.5vl:7b

# OpenAI routes. Leave OPENAI_API_KEY empty to keep these routes unavailable.
OPENAI_API_KEY=
LITELLM_OPENAI_API_BASE=https://api.openai.com/v1
LITELLM_OPENAI_CHAT_MODEL=openai/gpt-4.1-mini
LITELLM_OPENAI_EMBED_MODEL=openai/text-embedding-3-small
LITELLM_OPENAI_VISION_MODEL=openai/gpt-4.1-mini

# Anthropic has no embeddings route; pair Claude with an Ollama/OpenAI embedder.
ANTHROPIC_API_KEY=
LITELLM_ANTHROPIC_API_BASE=https://api.anthropic.com
LITELLM_ANTHROPIC_CHAT_MODEL=anthropic/claude-sonnet-4-5-20250929
LITELLM_ANTHROPIC_VISION_MODEL=anthropic/claude-sonnet-4-5-20250929


## ============================================================
## Ollama and RAG Models
## ============================================================

OLLAMA_API_URL=http://hawki_ollama:11434/api
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_RAG_MODEL=llama3.1:8b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
OLLAMA_CHAT_MODELS=llama3.1:8b
OLLAMA_EMBED_MODELS=bge-m3
OLLAMA_VISION_MODELS=qwen2.5vl:7b
OLLAMA_CHAT_TIMEOUT=240
OLLAMA_EMBED_NAN_ZERO_FALLBACK=true

GRAPH_OLLAMA_RAG_MODEL=llama3.1:8b
GRAPH_OLLAMA_VISION_MODEL=qwen2.5vl:7b
# GRAPH_OLLAMA_RAG_MODEL=llama3.2:3b


## ============================================================
## Qdrant
## ============================================================

QDRANT_HTTP_URL=http://qdrant:6333
QDRANT_SCHEME=http
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=hawki_docs
QDRANT_API_KEY=
QDRANT_TIMEOUT=30
QDRANT_RETRY_ATTEMPTS=3
QDRANT_TEXT_FALLBACK_TERMS=3

# Python API startup checks
STARTUP_CHECKS_ENABLED=false
STARTUP_CHECK_ATTEMPTS=3
STARTUP_CHECK_TIMEOUT_SECONDS=3
STARTUP_CHECK_BACKOFF_SECONDS=0.5


## ============================================================
## Neo4j
## ============================================================

NEO4J_HTTP_URL=http://neo4j:7474
# NEO4J_BOLT_URL=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
NEO4J_DATABASE=
# Driver-owned retry window for execute_read/execute_write managed transactions.
NEO4J_MAX_TRANSACTION_RETRY_TIME=30


## ============================================================
## RAG-Anything / LightRAG Graph
## ============================================================

GRAPH_ENGINE=raganything

# Python mode requires DATASET_BACKEND=python, PIPELINE_EXECUTION_BACKEND=python,
RAG_WORKING_DIR=/app/rag_storage

GRAPH_DOC_MAX_CHUNKS=6
GRAPH_DOC_MAX_CHARS=6000
GRAPH_RESET_CACHE_PER_DOC=true
GRAPH_MIN_CHUNK_CHARS=80
GRAPH_MIN_DOC_CHARS=80
GRAPH_TEMPERATURE=0.0
GRAPH_STRIP_PIPES=true
GRAPH_DISABLE_GLEANING=false
GRAPH_PROMPT_MAX_EXAMPLES=1
GRAPH_PERF_LOG=0

KG_MAX_GLEANING=1
KG_LANGUAGE=English
KG_ENTITY_TYPES='["Person","Organization","Location","Event","Concept"]'

GRAPH_EMBED_JUNK_STRICT=true
GRAPH_EMBED_JUNK_DENYLIST=
GRAPH_EMBED_JUNK_ALLOWLIST=

MAX_ASYNC=2
MAX_PARALLEL_INSERT=2
OLLAMA_NUM_PREDICT=256
OLLAMA_NUM_GPU=1
OLLAMA_GPU_LAYERS=999


## ============================================================
## Reranking and Query
## ============================================================

RERANKER_PROVIDER=cohere
RERANKER_MODE=external
RERANKER_API_URL=http://rag_reranker/v1/rerank
RERANKER_MIX_MODE=true
JINA_API_KEY=
JINA_RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v1
QUERY_MODE=mix


## ============================================================
## Search Providers
## ============================================================

WEB_SEARCH_PROVIDER=tavily
BRAVE_SEARCH_API_KEY=
TAVILY_SEARCH_API_KEY=


## ============================================================
## Optional External APIs and Storage
## ============================================================

# CRAWL4AI_API_TOKEN=

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# MEMCACHED_HOST=127.0.0.1


## ============================================================
## HAWKI Backend Persistence
## ============================================================
## Python owns only the `hawki_backend` PostgreSQL schema.
##
## IMPORTANT:
## Production must use a dedicated least-privilege PostgreSQL role
## restricted to the `hawki_backend` schema.
##
## The dedicated runtime role is intentionally not provisioned by this branch.

RAG_BACKEND_DB_DSN=postgresql+psycopg://hawki_backend_app:change_me@postgres:5432/hawki_rag
RAG_BACKEND_DB_POOL_SIZE=5
RAG_BACKEND_DB_POOL_TIMEOUT_SECONDS=3
RAG_BACKEND_DB_POOL_RECYCLE_SECONDS=300
RAG_BACKEND_DB_CONNECT_TIMEOUT_SECONDS=3
RAG_BACKEND_DB_STATEMENT_TIMEOUT_MS=2000
# TEST ONLY.
# Destructive persistence integration tests run only when BOTH:
# - RAG_BACKEND_DB_TESTING=1
# - the database name ends with `_test`
# Never enable this against the application database.
# RAG_BACKEND_DB_TESTING=1

## ============================================================
## Docker Compose and Container Adapters
## ============================================================

# Compose reads this project file. Service defaults and development overrides
# live in docker/env/. Use --env-file with the same project file when changing
# RAG_COMPOSE_ENV_FILE.
RAG_COMPOSE_ENV_FILE=.env

# Host identity used for shared-volume ownership.
PUID=1000
PGID=1000
PIPELINE_SHARED_STORAGE_UID=${PUID}
PIPELINE_SHARED_STORAGE_GID=${PGID}


# Adapter names required by the PostgreSQL and Temporal images. Credentials
# reference the canonical DB_* values instead of duplicating their contents.
POSTGRES_DB=${DB_DATABASE}
POSTGRES_USER=${DB_USERNAME}
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_PWD=${DB_PASSWORD}
POSTGRES_SEEDS=postgres
DB=postgres12
BIND_ON_IP=0.0.0.0
DEFAULT_NAMESPACE=${TEMPORAL_NAMESPACE}
TZ=Europe/Berlin

# Internal service addresses and PostgreSQL-backed monitor retention.
NEO4J_AUTH=${NEO4J_USER}/${NEO4J_PASSWORD}
NEO4J_URI=bolt://neo4j:7687
RAG_MONITOR_RETENTION_DAYS=30
RAG_WORKER_CALLBACK_URL=http://rag_backend/internal/pipeline/worker-events
RAG_TEMPORAL_SCRAPER_LOG_PATH=/shared/logs/scraper_worker.log
RAG_TEMPORAL_CONVERTER_LOG_PATH=/shared/logs/converter_worker.log
RAG_TEMPORAL_INDEXER_LOG_PATH=/shared/logs/indexer_worker.log

# Container image/runtime settings previously defaulted in Compose.
GPU_MIN_FREE_MB=4096
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm:main-stable

## ============================================================
## FastAPI service API and dataset authority
## ============================================================

RAG_BACKEND_SERVICE_ONLY=true
RAG_BACKEND_QUERY_DATASET_SOURCE=database
# Do not set RAG_BACKEND_QUERY_DATASETS in database mode.
RAG_BACKEND_QUERY_MODELS={"ollama":{"chat_model":"llama3.1:8b","vision_model":"qwen2.5vl:7b"}}
RAG_BACKEND_QUERY_RERANKER=external
RERANKER_API_DIALECT=hawki-cohere-v1
RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v1
RAG_RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v1
# RERANKER_API_KEY=
RAG_BACKEND_DATASET_EMBEDDING_PROVIDER=ollama
RAG_BACKEND_DATASET_EMBEDDING_MODEL=bge-m3
RAG_BACKEND_TEXT_INGESTION_ENABLED=true
RAG_BACKEND_MANAGED_DOCUMENTS_ENABLED=true
RAG_BACKEND_URL_INGESTION_ENABLED=false
RAG_BACKEND_URL_RECONCILE_ENABLED=true
RAG_BACKEND_DATASET_CLEANUP_ENABLED=false
RAG_BACKEND_TEXT_INGESTION_SHARED_ROOT=/shared
RAG_BACKEND_TEXT_INGESTION_QDRANT_URL=http://qdrant:6333
# RAG_BACKEND_TEXT_INGESTION_QDRANT_API_KEY=
# Optional server-owned directory for approved site profiles.
RAG_URL_SITE_PROFILE_ROOT=
RAG_WORKER_CALLBACK_MAX_AGE_SECONDS=300

# External service JWT verifier. Values below are placeholders, not a usable issuer.
RAG_BACKEND_AUTH_ISSUER=https://issuer.example.invalid
RAG_BACKEND_AUTH_AUDIENCE=hawki-backend
RAG_BACKEND_AUTH_JWKS_URL=https://issuer.example.invalid/.well-known/jwks.json
RAG_BACKEND_AUTH_CLIENTS={"hawki-service":"service","rag-management":"service"}
RAG_BACKEND_AUTH_ALGORITHMS=RS256,ES256
RAG_BACKEND_READINESS_JWKS_KEY_ID=

# Enable only when deployment-managed custom converter defaults are intended.
RAG_BACKEND_CUSTOM_UPLOADS_ENABLED=false
