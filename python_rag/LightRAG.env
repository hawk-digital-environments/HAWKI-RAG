# LightRAG 

ENV=production
LOG_LEVEL=info

# Vector DB: Qdrant CONF
VECTOR_DB=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=
QDRANT_SEARCH_ALL=true
QDRANT_SEARCH_ALL_PER_COLLECTION=5
QDRANT_DISTANCE=Cosine

# WEBUI DETAILS AND CONF
HOST=0.0.0.0
PORT=9621
WEBUI_TITLE='My Graph KB'
WEBUI_DESCRIPTION="Simple and Fast Graph Based RAG System"
LOG_LEVEL=INFO
MAX_ASYNC=2
MAX_PARALLEL_INSERT=2
SERVE_STATIC_WEBUI=false

# Reranking (local Cohere-compatible service) CONF
RERANK_BINDING=cohere
RERANK_MODEL=mixedbread-ai/mxbai-rerank-base-v1
RERANK_BINDING_HOST=http://lightrag_rerank:8000/v1/rerank
# RERANK_BINDING_API_KEY=

# LLM via Ollama (local service)
LLM_BINDING=ollama
LLM_MODEL=llama3.1:8b
LLM_BINDING_HOST=http://ollama:11434
LLM_BINDING_API_KEY=
OPENAI_LLM_MAX_COMPLETION_TOKENS=9000

# EMBEDDINGS CONF > OLLAMA
EMBEDDING_BINDING=ollama
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_DIM=1024
# The service name is 'ollama' on the shared hawki-network
EMBEDDING_BINDING_HOST=http://ollama:11434

OLLAMA_TEXT_MODEL=llama3.1:8b
OLLAMA_RAG_MODEL=llama3.1:8b

# Neo4j (KG) CONF
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=ixdlabPass123
NEO4J_DATABASE=hawki_kd

# LightRAG CONF
LIGHTRAG_VECTOR_STORAGE=QdrantVectorDBStorage
LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
WORKSPACE=hawki
COSINE_THRESHOLD=0.2

# Reranker CONF
RERANKER_PROVIDER=cohere
RERANKER_MODE=external
RERANKER_API_URL=http://hawki_rag_rerank:8000/v1/rerank
RERANKER_MIX_MODE=true
JINA_API_KEY=
JINA_RERANKER_MODEL=mixedbread-ai/mxbai-rerank-base-v1
QUERY_MODE=mix

# LIGHTRAG AUTH
API_KEY=

# OLLAMA CONF
#for local > 
# OLLAMA_API_URL=http://localhost:11434/api
#for server >
OLLAMA_API_URL=http://hawki_ollama:11434/api
OLLAMA_CHAT_TIMEOUT=600
OLLAMA_CHAT_RETRIES=2
OLLAMA_CHAT_BACKOFF=1.5
OLLAMA_CHAT_JITTER=0.2
OLLAMA_NUM_PREDICT=512
OLLAMA_TOP_P=0.9


# GWDG CONF
# GWDG_API_KEY=0a03a662ec70b688f933708c15fa3a28
# GWDG_API_URL=https://chat-ai.academiccloud.de/v1
KG_LANGUAGE=English,German
GRAPH_TEMPERATURE=0.0
GRAPH_STRIP_PIPES=true
GRAPH_MAX_LINES=25
GRAPH_MAX_CHARS=1200
# Optional if you want clean logs:
GRAPH_SUPPRESS_WARNINGS=true
