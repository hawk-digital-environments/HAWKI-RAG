# Copy to .env.scraper-worker for the Compose scraper worker.
# Use a permanent-job-v2 endpoint reachable from the worker.
EXTERNAL_SCRAPER_URL=https://crawler.example.org
EXTERNAL_SCRAPER_TOKEN=
